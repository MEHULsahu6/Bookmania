<!--==================== HEADER ====================-->
<header class="header" id="header">
   <nav class="nav container">
      <a href="#" class="nav__logo">
         <i class="ri-book-line"></i> E-Book
      </a>
      <div class="nav__menu">
         <ul class="nav__list">
            <li class="nav__item">
               <a href="/" class="nav__link active-link">
                  <i class="ri-home-line"></i>
                  <span class="nav__text">Home</span>
               </a>
            </li>
 
            <li class="nav__item">
               <a href="#featured" class="nav__link">
                  <i class="ri-book-3-line"></i>
                  <span class="nav__text">Featured</span>
               </a>
            </li>
 
            <li class="nav__item">
               <a href="#discount" class="nav__link">
                  <i class="ri-price-tag-3-line"></i>
                  <span class="nav__text">Discount</span>
               </a>
            </li>
 
            <li class="nav__item">
               <a href="#new" class="nav__link">
                  <i class="ri-bookmark-line"></i>
                  <span class="nav__text">New Books</span>
               </a>
            </li>
 
            <li class="nav__item">
               <a href="#explore" class="nav__link">
                  <i class="ri-compass-3-line"></i>
                  <span class="nav__text">Explore</span>
               </a>
            </li>
 
            <li class="nav__item">
               <a href="#testimonial" class="nav__link">
                  <i class="ri-message-3-line"></i>
                  <span class="nav__text">Testimonial</span>
               </a>
            </li>
         </ul>
      </div>
 
      <div class="nav__actions">
         <!-- Search button -->
         <a href="#" class="search-button" id="search-button">
            <i class="ri-search-line"></i>
            <span class="action__text">Search</span>
         </a>
   
         <!-- Cart button -->
         <a href="/cart" class="cart-button" id="cart-button">
            <i class="ri-shopping-cart-line"></i>
            <span class="action__text">Cart</span>
           
         </a>

         <!-- Wishlist button -->
         <a href="/wishlist" class="wishlist-button" id="wishlist-button">
            <i class="ri-heart-line"></i>
            <span class="action__text">Wishlist</span>
          
         </a>
   
         <!-- Profile button -->
         <a href="/profile" class="profile" id="profile-button">
            <i class="ri-user-line"></i>
            <span class="action__text">Profile</span>
         </a>
 
         <!-- Logout button -->
         <a href="/logout" class="logout-button" id="logout-button">
            <i class="ri-logout-box-line"></i>
            <span class="action__text">Logout</span>
         </a>
   
         <!-- Theme button -->
         <a href="#theme" class="change-button" id="theme-button">
            <i class="ri-moon-line"></i>
            <span class="action__text">Theme</span>
         </a>
      </div>
   </nav>
   <!--==================== SEARCH ====================-->
   <div class="search" id="search-content">
      <form action="" class="search__form">
         <i class="ri-search-line search__icon"></i>
         <input type="search" placeholder="What are you looking for?" class="search__input">
      </form>
      <i class="ri-close-line search-close" id="search-close"></i>
   </div>
</header>