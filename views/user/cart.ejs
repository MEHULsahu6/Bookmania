<!DOCTYPE html>
<html lang="en">
<head>
   <meta charset="UTF-8">
   <meta name="viewport" content="width=device-width, initial-scale=1.0">
   <link rel="shortcut icon" href="assets/img/favicon.png" type="image/x-icon">
   <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/3.5.0/remixicon.css">
  
   <link rel="stylesheet" href="../../stylesheets/User/cart.css">
   <link rel="stylesheet" href="../../stylesheets/User/home.css">

   <title>Cart - Book Mania</title>
   <style>
    :root {
      /* Fallback variables if not defined in home.css */
      --first-color: #4a90e2;
      --container-color: #f9f9f9;
      --white-color: #ffffff;
      --text-color: #333333;
      --text-color-light: #666666;
      --border-color: #e0e0e0;
      --header-height: 60px;
      --font-medium: 500;
      --font-semi-bold: 600;
    }

    /* Reset default styles */
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    body {
      font-family: Arial, sans-serif;
      background-color: #eef2f7;
      color: var(--text-color);
    }

    .main {
      padding-top: calc(var(--header-height) + 2rem);
    }

    .checkout-progress {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1rem 1.5rem;
      background: var(--white-color);
      margin: 0 auto 3rem;
      border-radius: 12px;
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.06);
      max-width: 900px;
      position: relative;
      overflow: hidden;
    }

    .progress-step {
      display: flex;
      flex-direction: column;
      align-items: center;
      color: var(--text-color);
      transition: all 0.3s ease;
      z-index: 2;
      width: 100px;
    }

    .progress-step i {
      font-size: 1.5rem;
      margin-bottom: 0.5rem;
      background: var(--container-color);
      padding: 0.75rem;
      border-radius: 50%;
      transition: all 0.3s ease;
      color: var(--text-color-light);
      border: 2px solid transparent;
    }

    .progress-step span {
      font-weight: var(--font-medium);
      font-size: 0.9rem;
      letter-spacing: 0.5px;
      text-transform: capitalize;
    }

    .progress-step.active {
      color: var(--first-color);
    }

    .progress-step.active i {
      background: var(--first-color);
      color: var(--white-color);
      border-color: var(--first-color);
      transform: scale(1.15);
      box-shadow: 0 4px 15px rgba(var(--first-color-rgb), 0.3);
    }

    .progress-line {
      flex-grow: 1;
      height: 3px;
      background: var(--border-color);
      margin: 0 0.5rem;
      position: relative;
      border-radius: 3px;
      transition: all 0.3s ease;
    }

    .progress-step.active + .progress-line {
      background: var(--first-color);
    }

    .checkout-progress::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      height: 100%;
      width: 0;
      background: rgba(var(--first-color-rgb), 0.05);
      transition: width 0.5s ease;
      z-index: 1;
    }

    .checkout-progress:has(#address-step.active)::before {
      width: 66%;
    }

    .checkout-progress:has(#payment-step.active)::before {
      width: 100%;
    }

    .progress-step:hover:not(.active) {
      color: var(--first-color);
    }

    .progress-step:hover:not(.active) i {
      background: rgba(var(--first-color-rgb), 0.1);
      color: var(--first-color);
    }

    @media screen and (max-width: 768px) {
      .checkout-progress {
        padding: 1rem;
        flex-direction: column;
        gap: 1.5rem;
      }

      .progress-line {
        display: none;
      }

      .progress-step {
        width: 100%;
        flex-direction: row;
        justify-content: flex-start;
        gap: 1rem;
      }

      .progress-step i {
        font-size: 1.25rem;
        padding: 0.6rem;
      }

      .progress-step span {
        font-size: 1rem;
      }
    }

    .cart-section,
    .address-section,
    .payment-section {
      display: none;
      padding: 2rem 0;
    }

    .cart-section.active,
    .address-section.active,
    .payment-section.active {
      display: block;
    }

    .cart__container {
      display: grid;
      grid-template-columns: 2fr 1fr;
      gap: 2rem;
      max-width: 1200px;
      margin: 0 auto;
      padding: 0 1rem;
    }

    .cart__items {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .cart__item {
      display: flex;
      align-items: center;
      padding: 1.5rem;
      background-color: var(--container-color);
      border: 1px solid var(--border-color);
      border-radius: 0.5rem;
      width: 100%;
      box-sizing: border-box;
    }

    .cart__item-img {
      width: 100px;
      height: 100px;
      object-fit: cover;
      margin-right: 1.5rem;
    }

    .cart__item-details {
      flex: 1;
      min-width: 0;
    }

    .cart__item-title {
      margin-bottom: 0.5rem;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
      max-width: 200px; /* Limit title width */
    }

    .cart__item-price {
      color: var(--first-color);
      font-weight: var(--font-semi-bold);
      margin-bottom: 0.5rem;
    }

    .cart__item-quantity {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }

    .quantity-btn {
      background-color: var(--first-color);
      color: var(--white-color);
      width: 30px;
      height: 30px;
      border-radius: 50%;
      cursor: pointer;
      border: none;
      font-size: 1rem;
    }

    .quantity-input {
      width: 60px;
      text-align: center;
      border: 1px solid var(--border-color);
      border-radius: 4px;
      padding: 0.25rem;
      font-size: 1rem;
    }

    .cart__item-remove {
      background: none;
      color: var(--text-color);
      cursor: pointer;
      margin-left: 1rem;
    }

    .cart__item-remove:hover {
      color: red;
    }

    .cart__summary {
      background-color: var(--container-color);
      padding: 1.5rem;
      border-radius: 0.5rem;
      position: sticky;
      top: calc(var(--header-height) + 2rem);
      width: 100%;
      box-sizing: border-box;
    }

    .summary__item {
      display: flex;
      justify-content: space-between;
      margin-bottom: 1rem;
      font-size: 1rem;
    }

    .summary__item.total {
      border-top: 1px solid var(--border-color);
      padding-top: 1rem;
      font-weight: var(--font-semi-bold);
      font-size: 1.2rem;
    }

    .address__container,
    .payment__container {
      max-width: 800px;
      margin: 0 auto;
    }

    .address-card,
    .payment-method {
      background-color: var(--container-color);
      padding: 1rem;
      border: 1px solid var(--border-color);
      border-radius: 0.5rem;
      margin-bottom: 1rem;
    }

    .address-card.selected {
      border-color: var(--first-color);
    }

    .address-form,
    .payment-form {
      display: grid;
      gap: 1rem;
      margin-top: 1rem;
    }

    .form-group input {
      width: 100%;
      padding: 0.75rem;
      border: 1px solid var(--border-color);
      border-radius: 0.5rem;
      background-color: var(--container-color);
    }

    .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1rem;
    }

    .payment-method label {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      cursor: pointer;
    }

    .payment-form {
      display: none;
    }

    .payment-form.active {
      display: block;
    }

    .address-buttons,
    .payment-buttons {
      display: flex;
      justify-content: space-between;
      margin-top: 2rem;
    }

    .button {
      display: inline-block;
      padding: 0.75rem 1.5rem;
      background-color: var(--first-color);
      color: var(--white-color);
      border: none;
      border-radius: 0.5rem;
      cursor: pointer;
      font-weight: var(--font-semi-bold);
      transition: 0.3s;
      width: 100%;
    }

    .button:hover {
      background-color: #357abd;
    }

    .button.back-btn {
      background-color: var(--text-color-light);
    }

    .button.back-btn:hover {
      background-color: #555555;
    }

    @media screen and (max-width: 768px) {
      .cart__container {
        grid-template-columns: 1fr;
        gap: 1.5rem;
      }

      .cart__item {
        flex-direction: column;
        align-items: flex-start;
        padding: 1rem;
      }

      .cart__item-img {
        margin-right: 0;
        margin-bottom: 1rem;
      }

      .cart__summary {
        position: static;
        top: auto;
      }

      .form-row {
        grid-template-columns: 1fr;
      }
    }
   </style>
</head>
<body>
   <!-- Placeholder for navbar -->
 <%- include('../user/partials/navbar.ejs') %>

  

   <main class="main">
      <!-- Checkout Progress -->
      <div class="checkout-progress">
         <div class="progress-step active" id="cart-step">
            <i class="ri-shopping-cart-line"></i>
            <span>Cart</span>
         </div>
         <div class="progress-line"></div>
         <div class="progress-step" id="address-step">
            <i class="ri-map-pin-line"></i>
            <span>Address</span>
         </div>
         <div class="progress-line"></div>
         <div class="progress-step" id="payment-step">
            <i class="ri-bank-card-line"></i>
            <span>Payment</span>
         </div>
      </div>

      <!-- Cart Section -->
      <section class="cart-section active" id="cart">
         <h2 class="section__title">Shopping Cart</h2>
         <div class="cart__container">
            <div class="cart__items">
               <% if (cart && cart.items && cart.items.length > 0) { %>
                  <% cart.items.forEach(item => { %>
                     <div class="cart__item" data-id="<%= item.book.id %>">
                        <img src="<%= item.book.image %>" alt="<%= item.book.title %>" class="cart__item-img">
                        <div class="cart__item-details">
                           <h3 class="cart__item-title"><%= item.book.title %></h3>
                           <p class="cart__item-price">$<%= item.book.price %></p>
                           <div class="cart__item-quantity">
                              <button class="quantity-btn minus">-</button>
                              <input type="number" value="<%= item.quantity %>" min="1" class="quantity-input">
                              <button class="quantity-btn plus">+</button>
                           </div>
                        </div>
                        <button class="cart__item-remove">
                           <i class="ri-delete-bin-line"></i>
                        </button>
                     </div>
                  <% }); %>
               <% } else { %>
                  <div class="cart-empty">
                     <i class="ri-shopping-cart-line"></i>
                     <p>Your cart is empty</p>
                  </div>
               <% } %>
            </div>
            <div class="cart__summary">
               <h3>Order Summary</h3>
               <% if (cart && cart.items && cart.items.length > 0) { %>
                  <% 
                     let subtotal = 0;
                     cart.items.forEach(item => {
                        subtotal += item.book.price * item.quantity;
                     });
                     const shipping = 5.00;
                     const total = subtotal + shipping;
                  %>
                  <div class="summary__item">
                     <span>Subtotal</span>
                     <span>$<%= subtotal.toFixed(2) %></span>
                  </div>
                  <div class="summary__item">
                     <span>Shipping</span>
                     <span>$<%= shipping.toFixed(2) %></span>
                  </div>
                  <div class="summary__item total">
                     <span>Total</span>
                     <span>$<%= total.toFixed(2) %></span>
                  </div>
                  <button class="button proceed-btn" onclick="showSection('address')">Proceed to Address</button>
               <% } else { %>
                  <div class="summary__item total">
                     <span>Total</span>
                     <span>$0.00</span>
                  </div>
                  <button class="button proceed-btn" disabled>Proceed to Address</button>
               <% } %>
            </div>
         </div>
      </section>

      <!-- Address Section -->
     <!-- Address Section -->
<section class="address-section" id="address">
   <h2 class="section__title">Shipping Address</h2>
   <div class="address__container">
       <div class="saved-addresses">
           <h3>Saved Addresses</h3>
           <% if (user && user.addresses && user.addresses.length > 0) { %>
               <% user.addresses.forEach((address, index) => { %>
                   <div class="address-card <%= address.isDefault ? 'selected' : '' %>">
                       <input type="radio" 
                              name="address" 
                              id="address<%= index %>" 
                              value="<%= address.id %>" 
                              <%= address.isDefault ? 'checked' : '' %>>
                       <label for="address<%= index %>">
                           <h4><%= address.fullName %></h4>
                           <p><%= address.street %></p>
                           <p><%= address.city %>, <%= address.state %> <%= address.zipCode %></p>
                           <p>Phone: <%= address.phone %></p>
                       </label>
                   </div>
               <% }); %>
           <% } else { %>
               <p>No saved addresses found</p>
           <% } %>
       </div>
       <div class="new-address">
           <h3>Add New Address</h3>
           <form class="address-form" id="addressForm">
               <div class="form-group">
                   <input type="text" name="fullName" placeholder="Full Name" required>
               </div>
               <div class="form-group">
                   <input type="text" name="street" placeholder="Street Address" required>
               </div>
               <div class="form-row">
                   <div class="form-group">
                       <input type="text" name="city" placeholder="City" required>
                   </div>
                   <div class="form-group">
                       <input type="text" name="state" placeholder="State" required>
                   </div>
               </div>
               <div class="form-row">
                   <div class="form-group">
                       <input type="text" name="zipCode" placeholder="ZIP Code" required>
                   </div>
                   <div class="form-group">
                       <input type="tel" name="phone" placeholder="Phone Number" required>
                   </div>
               </div>
               <button type="submit" class="button">Save Address</button>
           </form>
       </div>
       <div class="address-buttons">
           <button class="button back-btn" onclick="showSection('cart')">Back to Cart</button>
           <button class="button proceed-btn" onclick="showSection('payment')">Proceed to Payment</button>
       </div>
   </div>
</section>

      <!-- Payment Section -->
      <section class="payment-section" id="payment">
         <h2 class="section__title">Payment Method</h2>
         <div class="payment__container">
            <div class="payment-methods">
               <div class="payment-method">
                  <input type="radio" name="payment" id="card" value="card">
                  <label for="card">
                     <i class="ri-bank-card-line"></i>
                     <span>Credit/Debit Card</span>
                  </label>
               </div>
               <div class="payment-method">
                  <input type="radio" name="payment" id="upi" value="upi">
                  <label for="upi">
                     <i class="ri-smartphone-line"></i>
                     <span>UPI</span>
                  </label>
               </div>
               <div class="payment-method">
                  <input type="radio" name="payment" id="cod" value="cod">
                  <label for="cod">
                     <i class="ri-money-dollar-box-line"></i>
                     <span>Cash on Delivery</span>
                  </label>
               </div>
            </div>
            <div class="payment-buttons">
               <button class="button back-btn" onclick="showSection('address')">Back to Address</button>
               <button class="button proceed-btn" onclick="placeOrder()">Place Order</button>
            </div>
         </div>
      </section>
   </main>
   </body> 
   
   <script>
      function showSection(sectionId) {
         document.querySelectorAll('.cart-section, .address-section, .payment-section').forEach(section => {
            section.classList.remove('active');
         });
         document.getElementById(sectionId).classList.add('active');

         document.querySelectorAll('.progress-step').forEach(step => {
            step.classList.remove('active');
         });

         switch(sectionId) {
            case 'cart':
               document.getElementById('cart-step').classList.add('active');
               break;
            case 'address':
               document.getElementById('cart-step').classList.add('active');
               document.getElementById('address-step').classList.add('active');
               break;
            case 'payment':
               document.getElementById('cart-step').classList.add('active');
               document.getElementById('address-step').classList.add('active');
               document.getElementById('payment-step').classList.add('active');
               break;
         }
      }

      document.querySelectorAll('.quantity-btn').forEach(btn => {
         btn.addEventListener('click', function() {
            const input = this.parentElement.querySelector('.quantity-input');
            if (this.classList.contains('plus')) {
               input.value = parseInt(input.value) + 1;
            } else if (this.classList.contains('minus') && input.value > 1) {
               input.value = parseInt(input.value) - 1;
            }
            // Update summary dynamically (placeholder)
            updateSummary();
         });
      });

      document.querySelectorAll('input[name="payment"]').forEach(radio => {
         radio.addEventListener('change', function() {
            document.querySelectorAll('.payment-form').forEach(form => {
               form.classList.remove('active');
            });
            const form = document.getElementById(`${this.id}-form`);
            if (form) form.classList.add('active');
         });
      });

      // Add this function in your script section
      async function placeOrder() {
          const selectedAddressRadio = document.querySelector('input[name="address"]:checked');
          const selectedPayment = document.querySelector('input[name="payment"]:checked');
      
          if (!selectedAddressRadio) {
              alert('Please select a delivery address');
              return;
          }
      
          if (!selectedPayment) {
              alert('Please select a payment method');
              return;
          }
      
          try {
              const response = await fetch('/cart/place-order', {
                  method: 'POST',
                  headers: {
                      'Content-Type': 'application/json'
                  },
                  body: JSON.stringify({
                      addressId: selectedAddressRadio.value,
                      paymentMethod: selectedPayment.value // Make sure this matches the enum values in order model
                  })
              });
      
              const result = await response.json();
              if (result.success) {
                  alert(`Order placed successfully! Order ID: ${result.orderId}`);
                  window.location.href = '/orders';
              } else {
                  alert(result.message || 'Error placing order');
              }
          } catch (error) {
              console.error('Error:', error);
              alert('Error placing order');
          }
      }

      function updateSummary() {
         // Placeholder function to update summary (implement server-side logic if needed)
         let subtotal = 0;
         document.querySelectorAll('.cart__item').forEach(item => {
            const price = parseFloat(item.querySelector('.cart__item-price').textContent.replace('$', ''));
            const quantity = parseInt(item.querySelector('.quantity-input').value);
            subtotal += price * quantity;
         });
         const shipping = 5.00;
         const total = subtotal + shipping;
         document.querySelector('.summary__item:nth-child(1) span:last-child').textContent = `$${subtotal.toFixed(2)}`;
         document.querySelector('.summary__item:nth-child(2) span:last-child').textContent = `$${shipping.toFixed(2)}`;
         document.querySelector('.summary__item.total span:last-child').textContent = `$${total.toFixed(2)}`;
      }

      // Initial summary update
      document.addEventListener('DOMContentLoaded', updateSummary);
   </script>
   <script>
      document.getElementById('addressForm').addEventListener('submit', async function(e) {
          e.preventDefault();
          
          const formData = new FormData(this);
          const addressData = Object.fromEntries(formData);
  
          try {
              const response = await fetch('/cart/save-address', {
                  method: 'POST',
                  headers: {
                      'Content-Type': 'application/json',
                  },
                  body: JSON.stringify(addressData)
              });
  
              const result = await response.json();
              if (result.success) {
                  alert('Address saved successfully!');
                  // Refresh the page to show the new address
                  window.location.reload();
              } else {
                  alert(result.message || 'Error saving address');
              }
          } catch (error) {
              console.error('Error:', error);
              alert('Error saving address');
          }
      });
  
      // Add this new function
      async function removeFromCart(bookId) {
          try {
              const response = await fetch(`/cart/remove/${bookId}`, {
                  method: 'DELETE',
                  headers: {
                      'Content-Type': 'application/json'
                  }
              });
  
              const result = await response.json();
              if (result.success) {
                  // Remove the item from DOM
                  const cartItem = document.querySelector(`.cart__item[data-id="${bookId}"]`);
                  cartItem.remove();
                  
                  // Update the cart summary
                  updateSummary();
                  
                  // If cart is empty, show empty cart message
                  const cartItems = document.querySelectorAll('.cart__item');
                  if (cartItems.length === 0) {
                      const cartItemsContainer = document.querySelector('.cart__items');
                      cartItemsContainer.innerHTML = `
                          <div class="cart-empty">
                              <i class="ri-shopping-cart-line"></i>
                              <p>Your cart is empty</p>
                          </div>
                      `;
                      
                  }
              } else {
                  alert(result.message || 'Error removing item from cart');
              }
          } catch (error) {
              console.error('Error:', error);
              alert('Error removing item from cart');
          }
      }
  
      // Add click event listeners for remove buttons
      document.querySelectorAll('.cart__item-remove').forEach(button => {
          button.addEventListener('click', function() {
              const cartItem = this.closest('.cart__item');
              const bookId = cartItem.dataset.id;
              removeFromCart(bookId);
          });
      });
   </script>
</body>
</html>