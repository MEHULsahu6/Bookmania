   <script>
      function showSection(sectionId) {
         // Hide all sections
         document.querySelectorAll('.cart-section, .address-section, .payment-section').forEach(section => {
            section.classList.remove('active');
         });

         // Show selected section
         document.getElementById(sectionId).classList.add('active');

         // Update progress steps
         document.querySelectorAll('.progress-step').forEach(step => {
            step.classList.remove('active');
         });

         switch(sectionId) {
            case 'cart':
               document.getElementById('cart-step').classList.add('active');
               break;
            case 'address':
               document.getElementById('cart-step').classList.add('active');
               document.getElementById('address-step').classList.add('active');
               break;
            case 'payment':
               document.getElementById('cart-step').classList.add('active');
               document.getElementById('address-step').classList.add('active');
               document.getElementById('payment-step').classList.add('active');
               break;
         }
      }

      // Handle quantity buttons
      document.querySelectorAll('.quantity-btn').forEach(btn => {
         btn.addEventListener('click', function() {
            const input = this.parentElement.querySelector('.quantity-input');
            if (this.classList.contains('plus')) {
               input.value = parseInt(input.value) + 1;
            } else if (this.classList.contains('minus') && input.value > 1) {
               input.value = parseInt(input.value) - 1;
            }
         });
      });

      // Handle payment method selection
      document.querySelectorAll('input[name="payment"]').forEach(radio => {
         radio.addEventListener('change', function() {
            document.querySelectorAll('.payment-form').forEach(form => {
               form.classList.remove('active');
            });
            const form = document.getElementById(`${this.id}-form`);
            if (form) form.classList.add('active');
         });
      });

      function placeOrder() {
         // Add your order placement logic here
         alert('Order placed successfully!');
         // Redirect to order confirmation page or home page
      }
   </script>
