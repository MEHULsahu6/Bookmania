<!DOCTYPE html>
<html lang="en">
<head>
   <meta charset="UTF-8">
   <meta name="viewport" content="width=device-width, initial-scale=1.0">
   <link rel="shortcut icon" href="assets/img/favicon.png" type="image/x-icon">
   <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/3.5.0/remixicon.css">
   <link rel="stylesheet" href="../../stylesheets/User/home.css">

   <link rel="stylesheet" href="../../stylesheets/User/cart.css">
   <title>Cart - Book Mania</title>
   <style>
    /* Import base styles */
@import 'home.css';

/* Cart Page Specific Styles */
.main {
  padding-top: var(--header-height);
}

/* Checkout Progress */
.checkout-progress {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 2rem 0;
  background-color: var(--container-color);
  margin-bottom: 2rem;
}

.progress-step {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: var(--text-color);
}

.progress-step.active {
  color: var(--first-color);
}

.progress-step i {
  font-size: 1.5rem;
  margin-bottom: 0.5rem;
}

.progress-line {
  width: 100px;
  height: 2px;
  background-color: var(--border-color);
  margin: 0 1rem;
}

/* Cart Section */
.cart-section,
.address-section,
.payment-section {
  display: none;
  padding: 2rem 0;
}

.cart-section.active,
.address-section.active,
.payment-section.active {
  display: block;
}

.cart__container {
  display: grid;
  grid-template-columns: 2fr 1fr;
  gap: 2rem;
}

.cart__item {
  display: flex;
  align-items: center;
  padding: 1rem;
  background-color: var(--container-color);
  border: 1px solid var(--border-color);
  margin-bottom: 1rem;
  border-radius: 0.5rem;
}

.cart__item-img {
  width: 100px;
  margin-right: 1rem;
}

.cart__item-details {
  flex: 1;
}

.cart__item-title {
  margin-bottom: 0.5rem;
}

.cart__item-price {
  color: var(--first-color);
  font-weight: var(--font-semi-bold);
  margin-bottom: 0.5rem;
}

.cart__item-quantity {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.quantity-btn {
  background-color: var(--first-color);
  color: var(--white-color);
  width: 24px;
  height: 24px;
  border-radius: 50%;
  cursor: pointer;
}

.quantity-input {
  width: 50px;
  text-align: center;
  border: 1px solid var(--border-color);
  border-radius: 4px;
  padding: 0.25rem;
}

.cart__item-remove {
  background: none;
  color: var(--text-color);
  cursor: pointer;
}

.cart__item-remove:hover {
  color: red;
}

/* Cart Summary */
.cart__summary {
  background-color: var(--container-color);
  padding: 1.5rem;
  border-radius: 0.5rem;
  position: sticky;
  top: calc(var(--header-height) + 2rem);
}

.summary__item {
  display: flex;
  justify-content: space-between;
  margin-bottom: 1rem;
}

.summary__item.total {
  border-top: 1px solid var(--border-color);
  padding-top: 1rem;
  font-weight: var(--font-semi-bold);
}

/* Address Section */
.address__container {
  max-width: 800px;
  margin: 0 auto;
}

.address-card {
  background-color: var(--container-color);
  padding: 1rem;
  border: 1px solid var(--border-color);
  border-radius: 0.5rem;
  margin-bottom: 1rem;
}

.address-card.selected {
  border-color: var(--first-color);
}

.address-form {
  display: grid;
  gap: 1rem;
  margin-top: 1rem;
}

.form-group input {
  width: 100%;
  padding: 0.75rem;
  border: 1px solid var(--border-color);
  border-radius: 0.5rem;
  background-color: var(--container-color);
}

.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1rem;
}

/* Payment Section */
.payment__container {
  max-width: 800px;
  margin: 0 auto;
}

.payment-method {
  background-color: var(--container-color);
  padding: 1rem;
  border: 1px solid var(--border-color);
  border-radius: 0.5rem;
  margin-bottom: 1rem;
}

.payment-method label {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  cursor: pointer;
}

.payment-form {
  display: none;
  margin-top: 1rem;
}

.payment-form.active {
  display: block;
}

/* Buttons */
.address-buttons,
.payment-buttons {
  display: flex;
  justify-content: space-between;
  margin-top: 2rem;
}

.back-btn {
  background-color: var(--text-color);
}

/* Responsive Design */
@media screen and (max-width: 768px) {
  .cart__container {
    grid-template-columns: 1fr;
  }

  .progress-line {
    width: 50px;
  }

  .form-row {
    grid-template-columns: 1fr;
  }
}
   </style>
</head>
<body>
   <!-- Include the navbar partial -->
   <%- include('partials/navbar') %>

   <main class="main">
      <!-- Checkout Progress -->
      <div class="checkout-progress">
         <div class="progress-step active" id="cart-step">
            <i class="ri-shopping-cart-line"></i>
            <span>Cart</span>
         </div>
         <div class="progress-line"></div>
         <div class="progress-step" id="address-step">
            <i class="ri-map-pin-line"></i>
            <span>Address</span>
         </div>
         <div class="progress-line"></div>
         <div class="progress-step" id="payment-step">
            <i class="ri-bank-card-line"></i>
            <span>Payment</span>
         </div>
      </div>

      <!-- Cart Section -->
      <section class="cart-section active" id="cart">
         <h2 class="section__title">Shopping Cart</h2>
         <div class="cart__container container">
            <div class="cart__items">
               <!-- Sample Cart Item -->
               <div class="cart__item">
                  <img src="../../img/book-1.png" alt="Book" class="cart__item-img">
                  <div class="cart__item-details">
                     <h3 class="cart__item-title">Book Title</h3>
                     <p class="cart__item-price">$19.99</p>
                     <div class="cart__item-quantity">
                        <button class="quantity-btn minus">-</button>
                        <input type="number" value="1" min="1" class="quantity-input">
                        <button class="quantity-btn plus">+</button>
                     </div>
                  </div>
                  <button class="cart__item-remove">
                     <i class="ri-delete-bin-line"></i>
                  </button>
               </div>
            </div>
            <div class="cart__summary">
               <h3>Order Summary</h3>
               <div class="summary__item">
                  <span>Subtotal</span>
                  <span>$19.99</span>
               </div>
               <div class="summary__item">
                  <span>Shipping</span>
                  <span>$5.00</span>
               </div>
               <div class="summary__item total">
                  <span>Total</span>
                  <span>$24.99</span>
               </div>
               <button class="button proceed-btn" onclick="showSection('address')">Proceed to Address</button>
            </div>
         </div>
      </section>

      <!-- Address Section -->
      <section class="address-section" id="address">
         <h2 class="section__title">Shipping Address</h2>
         <div class="address__container container">
            <div class="saved-addresses">
               <h3>Saved Addresses</h3>
               <div class="address-card selected">
                  <input type="radio" name="address" id="address1" checked>
                  <label for="address1">
                     <h4>Home</h4>
                     <p>John Doe</p>
                     <p>123 Main Street, Apt 4B</p>
                     <p>New York, NY 10001</p>
                     <p>Phone: (123) 456-7890</p>
                  </label>
               </div>
            </div>
            <div class="new-address">
               <h3>Add New Address</h3>
               <form class="address-form">
                  <div class="form-group">
                     <input type="text" placeholder="Full Name" required>
                  </div>
                  <div class="form-group">
