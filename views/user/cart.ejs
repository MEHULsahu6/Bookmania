<!DOCTYPE html>
<html lang="en">
<head>
   <meta charset="UTF-8">
   <meta name="viewport" content="width=device-width, initial-scale=1.0">
   <link rel="shortcut icon" href="assets/img/favicon.png" type="image/x-icon">
   <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/3.5.0/remixicon.css">
   <link rel="stylesheet" href="../../stylesheets/User/home.css">

   <link rel="stylesheet" href="../../stylesheets/User/cart.css">
   <title>Cart - Book Mania</title>
   <style>
    /* Import base styles */
@import 'home.css';

/* Cart Page Specific Styles */
.main {
  padding-top: var(--header-height);
}

/* Checkout Progress */
.checkout-progress {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 2rem 0;
  background-color: var(--container-color);
  margin-bottom: 2rem;
}

.progress-step {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: var(--text-color);
}

.progress-step.active {
  color: var(--first-color);
}

.progress-step i {
  font-size: 1.5rem;
  margin-bottom: 0.5rem;
}

.progress-line {
  width: 100px;
  height: 2px;
  background-color: var(--border-color);
  margin: 0 1rem;
}

/* Cart Section */
.cart-section,
.address-section,
.payment-section {
  display: none;
  padding: 2rem 0;
}

.cart-section.active,
.address-section.active,
.payment-section.active {
  display: block;
}

.cart__container {
  display: grid;
  grid-template-columns: 2fr 1fr;
  gap: 2rem;
}

.cart__item {
  display: flex;
  align-items: center;
  padding: 1rem;
  background-color: var(--container-color);
  border: 1px solid var(--border-color);
  margin-bottom: 1rem;
  border-radius: 0.5rem;
}

.cart__item-img {
  width: 100px;
  margin-right: 1rem;
}

.cart__item-details {
  flex: 1;
}

.cart__item-title {
  margin-bottom: 0.5rem;
}

.cart__item-price {
  color: var(--first-color);
  font-weight: var(--font-semi-bold);
  margin-bottom: 0.5rem;
}

.cart__item-quantity {
  display: flex;
  align-items: center;
  gap: 0.5rem;
}

.quantity-btn {
  background-color: var(--first-color);
  color: var(--white-color);
  width: 24px;
  height: 24px;
  border-radius: 50%;
  cursor: pointer;
}

.quantity-input {
  width: 50px;
  text-align: center;
  border: 1px solid var(--border-color);
  border-radius: 4px;
  padding: 0.25rem;
}

.cart__item-remove {
  background: none;
  color: var(--text-color);
  cursor: pointer;
}

.cart__item-remove:hover {
  color: red;
}

/* Cart Summary */
.cart__summary {
  background-color: var(--container-color);
  padding: 1.5rem;
  border-radius: 0.5rem;
  position: sticky;
  top: calc(var(--header-height) + 2rem);
}

.summary__item {
  display: flex;
  justify-content: space-between;
  margin-bottom: 1rem;
}

.summary__item.total {
  border-top: 1px solid var(--border-color);
  padding-top: 1rem;
  font-weight: var(--font-semi-bold);
}

/* Address Section */
.address__container {
  max-width: 800px;
  margin: 0 auto;
}

.address-card {
  background-color: var(--container-color);
  padding: 1rem;
  border: 1px solid var(--border-color);
  border-radius: 0.5rem;
  margin-bottom: 1rem;
}

.address-card.selected {
  border-color: var(--first-color);
}

.address-form {
  display: grid;
  gap: 1rem;
  margin-top: 1rem;
}

.form-group input {
  width: 100%;
  padding: 0.75rem;
  border: 1px solid var(--border-color);
  border-radius: 0.5rem;
  background-color: var(--container-color);
}

.form-row {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1rem;
}

/* Payment Section */
.payment__container {
  max-width: 800px;
  margin: 0 auto;
}

.payment-method {
  background-color: var(--container-color);
  padding: 1rem;
  border: 1px solid var(--border-color);
  border-radius: 0.5rem;
  margin-bottom: 1rem;
}

.payment-method label {
  display: flex;
  align-items: center;
  gap: 0.5rem;
  cursor: pointer;
}

.payment-form {
  display: none;
  margin-top: 1rem;
}

.payment-form.active {
  display: block;
}

/* Buttons */
.address-buttons,
.payment-buttons {
  display: flex;
  justify-content: space-between;
  margin-top: 2rem;
}

.back-btn {
  background-color: var(--text-color);
}

/* Responsive Design */
@media screen and (max-width: 768px) {
  .cart__container {
    grid-template-columns: 1fr;
  }

  .progress-line {
    width: 50px;
  }

  .form-row {
    grid-template-columns: 1fr;
  }
}
   </style>
</head>
<body>
   <!-- Include the navbar partial -->
   <%- include('partials/navbar') %>

   <main class="main">
      <!-- Checkout Progress -->
      <div class="checkout-progress">
         <div class="progress-step active" id="cart-step">
            <i class="ri-shopping-cart-line"></i>
            <span>Cart</span>
         </div>
         <div class="progress-line"></div>
         <div class="progress-step" id="address-step">
            <i class="ri-map-pin-line"></i>
            <span>Address</span>
         </div>
         <div class="progress-line"></div>
         <div class="progress-step" id="payment-step">
            <i class="ri-bank-card-line"></i>
            <span>Payment</span>
         </div>
      </div>

      <!-- Cart Section -->
      <section class="cart-section active" id="cart">
         <h2 class="section__title">Shopping Cart</h2>
         <div class="cart__container container">
            <div class="cart__items">
               <!-- Sample Cart Item -->
               <div class="cart__item">
                  <img src="../../img/book-1.png" alt="Book" class="cart__item-img">
                  <div class="cart__item-details">
                     <h3 class="cart__item-title">Book Title</h3>
                     <p class="cart__item-price">$19.99</p>
                     <div class="cart__item-quantity">
                        <button class="quantity-btn minus">-</button>
                        <input type="number" value="1" min="1" class="quantity-input">
                        <button class="quantity-btn plus">+</button>
                     </div>
                  </div>
                  <button class="cart__item-remove">
                     <i class="ri-delete-bin-line"></i>
                  </button>
               </div>
            </div>
            <div class="cart__summary">
               <h3>Order Summary</h3>
               <div class="summary__item">
                  <span>Subtotal</span>
                  <span>$19.99</span>
               </div>
               <div class="summary__item">
                  <span>Shipping</span>
                  <span>$5.00</span>
               </div>
               <div class="summary__item total">
                  <span>Total</span>
                  <span>$24.99</span>
               </div>
               <button class="button proceed-btn" onclick="showSection('address')">Proceed to Address</button>
            </div>
         </div>
      </section>

      <!-- Address Section -->
      <section class="address-section" id="address">
         <h2 class="section__title">Shipping Address</h2>
         <div class="address__container container">
            <div class="saved-addresses">
               <h3>Saved Addresses</h3>
               <div class="address-card selected">
                  <input type="radio" name="address" id="address1" checked>
                  <label for="address1">
                     <h4>Home</h4>
                     <p>John Doe</p>
                     <p>123 Main Street, Apt 4B</p>
                     <p>New York, NY 10001</p>
                     <p>Phone: (123) 456-7890</p>
                  </label>
               </div>
            </div>
            <div class="new-address">
               <h3>Add New Address</h3>
               <form class="address-form">
                  <div class="form-group">
                     <input type="text" placeholder="Full Name" required>
                  </div>
                  <div class="form-group">
                     <input type="text" placeholder="Mobile Number" required>
                  </div>
                  <div class="form-group">
                     <input type="text" placeholder="Street Address" required>
                  </div>
                  <div class="form-row">
                     <input type="text" placeholder="City" required>
                     <input type="text" placeholder="State" required>
                  </div>
                  <div class="form-group">
                     <input type="text" placeholder="ZIP Code" required>
                  </div>
               </form>
            </div>
            <div class="address-buttons">
               <button class="button back-btn" onclick="showSection('cart')">Back to Cart</button>
               <button class="button proceed-btn" onclick="showSection('payment')">Proceed to Payment</button>
            </div>
         </div>
      </section>

      <!-- Payment Section -->
      <section class="payment-section" id="payment">
         <h2 class="section__title">Payment Method</h2>
         <div class="payment__container container">
            <div class="payment-methods">
               <div class="payment-method">
                  <input type="radio" name="payment" id="card" checked>
                  <label for="card">
                     <i class="ri-bank-card-line"></i>
                     Credit/Debit Card
                  </label>
                  <div class="payment-form active">
                     <div class="form-group">
                        <input type="text" placeholder="Card Number" required>
                     </div>
                     <div class="form-row">
                        <input type="text" placeholder="MM/YY" required>
                        <input type="text" placeholder="CVV" required>
                     </div>
                     <div class="form-group">
                        <input type="text" placeholder="Name on Card" required>
                     </div>
                  </div>
               </div>
               <div class="payment-method">
                  <input type="radio" name="payment" id="upi">
                  <label for="upi">
                     <i class="ri-smartphone-line"></i>
                     UPI
                  </label>
                  <div class="payment-form">
                     <div class="form-group">
                        <input type="text" placeholder="UPI ID" required>
                     </div>
                  </div>
               </div>
               <div class="payment-method">
                  <input type="radio" name="payment" id="cod">
                  <label for="cod">
                     <i class="ri-money-dollar-box-line"></i>
                     Cash on Delivery
                  </label>
               </div>
            </div>
            <div class="payment__summary">
               <h3>Payment Summary</h3>
               <div class="summary__item">
                  <span>Order Total</span>
                  <span>$24.99</span>
               </div>
               <div class="summary__item">
                  <span>Payment Method</span>
                  <span>Credit Card</span>
               </div>
               <div class="summary__item total">
                  <span>Total to Pay</span>
                  <span>$24.99</span>
               </div>
            </div>
            <div class="payment-buttons">
               <button class="button back-btn" onclick="showSection('address')">Back to Address</button>
               <button class="button proceed-btn">Place Order</button>
            </div>
         </div>
      </section>
   </main>

  

   <script>
    // Show active section and update progress
function showSection(sectionId) {
    // Hide all sections
    document.querySelectorAll('.cart-section, .address-section, .payment-section').forEach(section => {
        section.classList.remove('active');
    });

    // Show selected section
    document.getElementById(sectionId).classList.add('active');

    // Update progress steps
    updateProgress(sectionId);
}

// Update progress indicator
function updateProgress(currentSection) {
    const steps = ['cart', 'address', 'payment'];
    const currentIndex = steps.indexOf(currentSection);

    steps.forEach((step, index) => {
        const stepElement = document.getElementById(`${step}-step`);
        if (index <= currentIndex) {
            stepElement.classList.add('active');
        } else {
            stepElement.classList.remove('active');
        }
    });
}

// Quantity buttons functionality
document.querySelectorAll('.quantity-btn').forEach(button => {
    button.addEventListener('click', function() {
        const input = this.parentElement.querySelector('.quantity-input');
        const currentValue = parseInt(input.value);

        if (this.classList.contains('plus')) {
            input.value = currentValue + 1;
        } else if (this.classList.contains('minus') && currentValue > 1) {
            input.value = currentValue - 1;
        }
        updateCartTotal();
    // Cart functionality
function updateCartTotal() {
    const cartItems = document.querySelectorAll('.cart__item');
    let subtotal = 0;

    cartItems.forEach(item => {
        const price = parseFloat(item.querySelector('.cart__item-price').textContent.replace('$', ''));
        const quantity = parseInt(item.querySelector('.quantity-input').value);
        subtotal += price * quantity;
    });

    const shipping = 5.00;
    const total = subtotal + shipping;

    // Update summary amounts
    document.querySelector('.summary__item:nth-child(1) span:last-child').textContent = `$${subtotal.toFixed(2)}`;
    document.querySelector('.summary__item.total span:last-child').textContent = `$${total.toFixed(2)}`;
}

// Handle quantity changes
document.addEventListener('DOMContentLoaded', function() {
    // Quantity buttons
    document.querySelectorAll('.quantity-btn').forEach(button => {
        button.addEventListener('click', function() {
            const input = this.parentElement.querySelector('.quantity-input');
            const currentValue = parseInt(input.value);

            if (this.classList.contains('plus')) {
                input.value = currentValue + 1;
            } else if (this.classList.contains('minus') && currentValue > 1) {
                input.value = currentValue - 1;
            }
            updateCartTotal();
        });
    });

    // Remove item button
    document.querySelectorAll('.cart__item-remove').forEach(button => {
        button.addEventListener('click', function() {
            this.closest('.cart__item').remove();
            updateCartTotal();
        });
    });

    // Section navigation
    document.querySelectorAll('.proceed-btn, .back-btn').forEach(button => {
        button.addEventListener('click', function() {
            const sections = ['cart', 'address', 'payment'];
            const currentSection = this.closest('section').id;
            const direction = this.classList.contains('proceed-btn') ? 1 : -1;
            const currentIndex = sections.indexOf(currentSection);
            const nextIndex = currentIndex + direction;

            if (nextIndex >= 0 && nextIndex < sections.length) {
                showSection(sections[nextIndex]);
            }
        });
    });

    // Payment method selection
    document.querySelectorAll('input[name="payment"]').forEach(radio => {
        radio.addEventListener('change', function() {
            document.querySelectorAll('.payment-form').forEach(form => {
                form.classList.remove('active');
            });
            if (this.checked) {
                const form = this.parentElement.querySelector('.payment-form');
                if (form) form.classList.add('active');
            }
        });
    });

    // Initialize cart total
    updateCartTotal();
});

// Add to cart functionality
function addToCart(bookData) {
    const cartItem = `
        <div class="cart__item">
            <img src="${bookData.image}" alt="${bookData.title}" class="cart__item-img">
            <div class="cart__item-details">
                <h3 class="cart__item-title">${bookData.title}</h3>
                <p class="cart__item-price">$${bookData.price}</p>
                <div class="cart__item-quantity">
                    <button class="quantity-btn minus">-</button>
                    <input type="number" value="1" min="1" class="quantity-input">
                    <button class="quantity-btn plus">+</button>
                </div>
            </div>
            <button class="cart__item-remove">
                <i class="ri-delete-bin-line"></i>
            </button>
        </div>
    `;

    document.querySelector('.cart__items').insertAdjacentHTML('beforeend', cartItem);
    updateCartTotal();
}

// Show active section and update progress
function showSection(sectionId) {
    // Hide all sections
    document.querySelectorAll('section').forEach(section => {
        section.classList.remove('active');
    });

    // Show selected section
    document.getElementById(sectionId).classList.add('active');

    // Update progress steps
    const steps = ['cart', 'address', 'payment'];
    const currentIndex = steps.indexOf(sectionId);

    steps.forEach((step, index) => {
        const stepElement = document.getElementById(`${step}-step`);
        if (index <= currentIndex) {
            stepElement.classList.add('active');
        } else {
            stepElement.classList.remove('active');
        }
    });
}
   </script>
   
</body>
</html>