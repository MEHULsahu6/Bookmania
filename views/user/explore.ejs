<!DOCTYPE html>
<html lang="en">
<head>
   <meta charset="UTF-8">
   <meta name="viewport" content="width=device-width, initial-scale=1.0">
   <link rel="shortcut icon" href="assets/img/favicon.png" type="image/x-icon">
   <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/3.5.0/remixicon.css">
   <link rel="stylesheet" href="../../stylesheets/User/home.css">
   <link rel="stylesheet" href="../../stylesheets/User/explore.css">
   <title>Explore Books - Book Mania</title>
   <style>
    @import url("https://fonts.googleapis.com/css2?family=Montagu+Slab:wght@500&family=Montserrat:wght@400;500;600&display=swap");

    :root {
      --header-height: 3.5rem;
      --first-color: hsl(230, 62%, 56%);
      --title-color: hsl(230, 70%, 16%);
      --text-color: hsl(230, 16%, 45%);
      --border-color: hsl(230, 50%, 90%);
      --white-color: hsl(0, 0%, 100%);
      --body-color: hsl(230, 100%, 96%);
      --container-color: hsl(230, 100%, 97%);
      --body-font: "Montserrat", sans-serif;
      --second-font: "Montagu Slab", serif;
      --biggest-font-size: 2rem;
      --h1-font-size: 1.5rem;
      --h2-font-size: 1.25rem;
      --h3-font-size: 1rem;
      --normal-font-size: .938rem;
      --small-font-size: .813rem;
      --smaller-font-size: .75rem;
    }

    .explore__filters {
      margin-bottom: 2rem;
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
      align-items: center;
      justify-content: space-between;
    }

    .filters__search {
      flex: 1;
      min-width: 280px;
      position: relative;
    }

    .search__input {
      width: 100%;
      padding: 1rem 3rem 1rem 1.5rem;
      border: 2px solid var(--border-color);
      border-radius: 4rem;
      font-family: var(--body-font);
      transition: border-color .3s;
    }

    .search__input:focus {
      border-color: var(--first-color);
    }

    .search__icon {
      position: absolute;
      right: 1.5rem;
      top: 50%;
      transform: translateY(-50%);
      color: var(--text-color);
    }

    .filters__options {
      display: flex;
      gap: 1rem;
    }

    .filter__select {
      padding: 0.75rem 1.5rem;
      border: 2px solid var(--border-color);
      border-radius: 4rem;
      font-family: var(--body-font);
      color: var(--text-color);
      cursor: pointer;
    }

    .explore__container {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
      gap: 2rem;
      padding: 1rem;
    }

    .explore__card {
      background-color: var(--container-color);
      padding: 1.5rem;
      border: 2px solid var(--border-color);
      border-radius: 1rem;
      transition: transform .3s, border-color .3s;
      display: flex;
      flex-direction: column;
      min-height: 400px; /* Set a minimum height for consistency */
      box-sizing: border-box;
    }

    .explore__card:hover {
      transform: translateY(-0.25rem);
      border-color: var(--first-color);
    }

    .explore__img {
      width: 100%;
      max-width: 150px;
      height: 200px; /* Fixed height for consistency */
      object-fit: cover; /* Ensure images scale properly */
      margin: 0 auto 1rem;
      transition: transform .3s;
    }

    .explore__card:hover .explore__img {
      transform: scale(1.05);
    }

    .explore__data {
      text-align: center;
      flex-grow: 1; /* Allow data section to expand */
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .explore__title {
      font-size: var(--h3-font-size);
      margin-bottom: .25rem;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .explore__author {
      color: var(--text-color);
      font-size: var(--small-font-size);
      margin-bottom: .75rem;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .explore__prices {
      display: flex;
      justify-content: center;
      gap: .75rem;
      margin-bottom: .75rem;
    }

    .explore__discount {
      color: var(--title-color);
      font-weight: var(--font-medium);
    }

    .explore__price {
      color: var(--text-color);
      text-decoration: line-through;
      font-size: var(--small-font-size);
    }

    .explore__stars {
      color: var(--first-color);
      display: flex;
      justify-content: center;
      align-items: center;
      gap: .25rem;
      margin-bottom: 1rem;
    }

    .explore__stars span {
      color: var(--text-color);
      font-size: var(--small-font-size);
      margin-left: .5rem;
    }

    .explore__button {
      width: 100%;
      text-align: center;
      padding: 0.75rem;
      background-color: var(--first-color);
      color: var(--white-color);
      border: none;
      border-radius: 0.5rem;
      cursor: pointer;
      transition: background-color .3s;
    }

    .explore__button:hover {
      background-color: hsl(230, 62%, 45%);
    }

    .error-message {
      color: red;
      text-align: center;
      margin: 1rem 0;
    }

    @media screen and (max-width: 768px) {
      .filters__options {
        width: 100%;
      }
      .filter__select {
        flex: 1;
      }
      .explore__container {
        grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      }
    }
   </style>
</head>
<body>
   <%- include('partials/navbar') %>

   <main class="main">
      <section class="explore section">
         <h2 class="section__title">All Books</h2>

         <div class="explore__filters container">
            <div class="filters__search">
               <input type="text" placeholder="Search books..." class="search__input">
               <i class="ri-search-line search__icon"></i>
            </div>
            
            <div class="filters__options">
               <select class="filter__select">
                  <option value="">Category</option>
                  <option value="fiction">Fiction</option>
                  <option value="non-fiction">Non-Fiction</option>
                  <option value="mystery">Mystery</option>
                  <option value="sci-fi">Sci-Fi</option>
               </select>

               <select class="filter__select">
                  <option value="">Sort By</option>
                  <option value="price-low">Price: Low to High</option>
                  <option value="price-high">Price: High to Low</option>
                  <option value="name">Name</option>
                  <option value="popular">Popularity</option>
               </select>
            </div>
         </div>

         <% if (typeof error !== 'undefined' && error) { %>
            <p class="error-message"><%= error %></p>
         <% } %>

         <div class="explore__container container grid">
            <% if (books && books.length > 0) { %>
                <% books.forEach(book => { %>
                    <article class="explore__card">
                        <img src="<%= book.image %>" alt="<%= book.title %>" class="explore__img">
                        <div class="explore__data">
                            <h3 class="explore__title"><%= book.title %></h3>
                            <p class="explore__author"><%= book.author %></p>
                            <div class="explore__prices">
                                <% if (book.discountPrice) { %>
                                    <span class="explore__discount">$<%= book.discountPrice.toFixed(2) %></span>
                                    <span class="explore__price">$<%= book.price.toFixed(2) %></span>
                                <% } else { %>
                                    <span class="explore__discount">$<%= book.price.toFixed(2) %></span>
                                <% } %>
                            </div>
                            <div class="explore__stars">
                                <i class="ri-star-fill"></i>
                                <i class="ri-star-fill"></i>
                                <i class="ri-star-fill"></i>
                                <i class="ri-star-fill"></i>
                                <i class="ri-star-line"></i>
                                <span>(4.0)</span>
                            </div>
                            <button class="explore__button" data-id="<%= book._id %>">Add To Cart</button>
                        </div>
                    </article>
                <% }); %>
            <% } else { %>
                <p>No books available at the moment.</p>
            <% } %>
         </div>
      </section>
   </main>

   <a href="#" class="scrollup" id="scroll-up">
      <i class="ri-arrow-up-line"></i>
   </a>
   
   <script src="../../javascripts/scrollreveal.min.js"></script>
   <script src="../../javascripts/swiper-bundle.min.js"></script>
   <script src="../../javascripts/user/home.js"></script>

   <script>
    document.addEventListener('DOMContentLoaded', () => {
        const searchInput = document.querySelector('.search__input');
        const filterSelects = document.querySelectorAll('.filter__select');
        const exploreCards = document.querySelectorAll('.explore__card');
        const addToCartButtons = document.querySelectorAll('.explore__button');

        searchInput.addEventListener('input', (e) => {
            const searchTerm = e.target.value.toLowerCase();
            
            exploreCards.forEach(card => {
                const title = card.querySelector('.explore__title').textContent.toLowerCase();
                const author = card.querySelector('.explore__author').textContent.toLowerCase();
                
                if (title.includes(searchTerm) || author.includes(searchTerm)) {
                    card.style.display = '';
                } else {
                    card.style.display = 'none';
                }
            });
        });

        filterSelects.forEach(select => {
            select.addEventListener('change', () => {
                console.log('Filter/Sort changed:', select.value);
            });
        });

        addToCartButtons.forEach(button => {
            button.addEventListener('click', () => {
                const bookId = button.getAttribute('data-id');
                console.log('Added to cart:', bookId);
            });
        });
    });
   </script>
</body>
</html>