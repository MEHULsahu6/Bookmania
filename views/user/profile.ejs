<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" href="assets/img/favicon.png" type="image/x-icon">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/3.5.0/remixicon.css">
    <link rel="stylesheet" href="../../stylesheets/User/swiper-bundle.min.css">
    <link rel="stylesheet" href="../../stylesheets/User/profile.css">
    <link rel="stylesheet" href="../../stylesheets/User/home.css">
    <title>User Profile | Book Mania</title>
    <style>
        .profile-header .personal-info { margin: 1rem; }
        .personal-info .card-body { padding: 1rem; }
        .info-item { margin-bottom: 1rem; display: flex; justify-content: space-between; align-items: center; }
        .info-label { font-weight: bold; color: #666; }
        .info-value-group { display: flex; align-items: center; gap: 0.5rem; }
        .info-value { color: #333; }
        .edit-btn, .add-btn {
            background: none;
            border: none;
            color: #007bff;
            cursor: pointer;
            padding: 0.2rem;
            font-size: 1rem;
        }
        .edit-btn:hover, .add-btn:hover { color: #0056b3; }
        .edit-field {
            display: none;
            margin-top: 0.5rem;
            gap: 0.5rem;
            align-items: center;
        }
        
        .edit-field.active {
            display: flex;
        }
        
        .info-item {
            position: relative;
            margin-bottom: 1.5rem;
        }
        
        .edit-field input,
        .edit-field select {
            padding: 0.5rem;
            border: 1px solid #ddd;
            border-radius: 4px;
            min-width: 200px;
        }
        
        .save-btn,
        .cancel-btn {
            padding: 0.5rem 1rem;
            border-radius: 4px;
            cursor: pointer;
            transition: all 0.3s ease;
        }
        
        .save-btn {
            background-color: #007bff;
            color: white;
            border: none;
        }
        
        .cancel-btn {
            background-color: #fff;
            border: 1px solid #ddd;
        }
        
        .save-btn:hover {
            background-color: #0056b3;
        }
        
        .cancel-btn:hover {
            background-color: #f8f9fa;
        }
    </style>
</head>
<body>
    <%- include('partials/navbar') %>

    <main class="main">
        <div class="profile-wrapper">
            <section class="profile-header">
                <div class="profile-cover">
                    <div class="profile-avatar-container">  
                        <img src="<%= userProfile && userProfile.profilePicture ? userProfile.profilePicture : '/img/profile_default.avif' %>" 
                             alt="User Avatar" 
                             class="profile-avatar"
                             id="preview-image">
                        <form action="/profile/upload-avatar" method="POST" enctype="multipart/form-data" class="avatar-upload-form">
                            <label for="avatar-input">
                                <i class="ri-camera-line"></i>
                            </label>
                            <input type="file" 
                                   id="avatar-input" 
                                   name="profileImage" 
                                   accept="image/*" 
                                   hidden>
                        </form>
                    </div>
                </div>
                <!-- Replace hardcoded values with dynamic data -->
                <div class="profile-info">
                    <h1 class="profile-name"><%= userProfile.fullName %></h1>
                    <p class="profile-email"><%= userProfile.email %></p>
                </div>
                <section class="personal-info card">
                    <div class="card-body">
                        <div class="info-item">
                            <span class="info-label">Mo No:</span>
                            <div class="info-value-container">
                                <span class="info-value"><%= userProfile.phoneNumber || 'Not provided' %></span>
                                <button class="edit-btn" onclick="openEditField('phone')">
                                    <i class="ri-edit-line"></i>
                                </button>
                            </div>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Gender: </span>
                            <div class="info-value-container">
                                <span class="info-value"><%= userProfile.gender || 'Not specified' %></span>
                                <button class="edit-btn" onclick="openEditField('gender')">
                                    <i class="ri-edit-line"></i>
                                </button>
                            </div>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Joined:</span>
                            <span class="info-value"><%= new Date(userProfile.memberSince).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></span>
                        </div>
                    </div>
                </section>
            </section>

            <div class="profile-content">
                <div class="profile-main">
                    <section class="ordered-books-reviews card">
                        <div class="card-header">
                            <h2>Leave a Review</h2>
                        </div>
                        <div class="reviews-list">
                            <p>No orders found. (Add orderHistory to schema if needed)</p>
                        </div>
                    </section>
                </div>
                <div class="profile-sidebar">
                    <!-- Sidebar content can be added here if needed -->
                </div>
            </div>
        </div>
    </main>

    <script src="../../javascripts/scrollreveal.min.js"></script>
    <script src="../../javascripts/swiper-bundle.min.js"></script>
    <script src="../../javascripts/user/home.js"></script>
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Modal related code
            const editProfileModal = document.getElementById('editProfileModal');
            const closeModalBtn = document.querySelector('.close-modal');
            
            if (editProfileModal && closeModalBtn) {
                closeModalBtn.addEventListener('click', () => {
                    editProfileModal.style.display = 'none';
                });

                window.addEventListener('click', (e) => {
                    if (e.target === editProfileModal) {
                        editProfileModal.style.display = 'none';
                    }
                });
            }

            // Profile image handling
            const profileImageInput = document.getElementById('avatar-input');
            const profileAvatar = document.querySelector('.profile-avatar');

            if (profileImageInput) {
                profileImageInput.addEventListener('change', function() {
                    const file = this.files[0];
                    if (file) {
                        const reader = new FileReader();
                        reader.onload = function(e) {
                            if (profileAvatar) {
                                profileAvatar.src = e.target.result;
                            }
                        };
                        reader.readAsDataURL(file);
                    }
                });
            }

            // Field editing functions
            window.showEditField = function(field) {
                const editField = document.getElementById(`${field}-edit`);
                if (editField) {
                    editField.style.display = 'flex';
                    const input = document.getElementById(`${field}-input`);
                    if (input) {
                        input.focus();
                    }
                }
            };

            window.cancelEdit = function(field) {
                const editField = document.getElementById(`${field}-edit`);
                if (editField) {
                    editField.style.display = 'none';
                    const input = document.getElementById(`${field}-input`);
                    if (input) {
                        input.value = input.defaultValue;
                    }
                }
            };

            window.saveField = async function(field) {
                const input = document.getElementById(`${field}-input`);
                if (!input) return;
                
                const value = input.value.trim();
                
                if (!value) {
                    alert('Please enter a valid value');
                    return;
                }

                try {
                    const response = await fetch('/user/profile/update-field', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({ field, value })
                    });

                    if (!response.ok) {
                        throw new Error('Server error');
                    }

                    const data = await response.json();
                    
                    if (data.success) {
                        const editField = document.getElementById(`${field}-edit`);
                        if (editField) {
                            const valueSpan = editField.previousElementSibling.querySelector('.info-value');
                            if (valueSpan) {
                                valueSpan.textContent = value;
                            }
                            editField.style.display = 'none';
                        }
                        alert('Updated successfully');
                    } else {
                        throw new Error(data.error || 'Update failed');
                    }
                } catch (error) {
                    console.error('Update error:', error);
                    alert('Failed to update profile. Please try again.');
                }
            };

            // Initialize edit buttons
            const editButtons = document.querySelectorAll('.edit-btn, .add-btn');
            editButtons.forEach(button => {
                button.addEventListener('click', function(e) {
                    e.preventDefault();
                    const field = this.getAttribute('data-field');
                    if (field) {
                        showEditField(field);
                    }
                });
            });
        });
    </script>
</body>
</html>