<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" href="assets/img/favicon.png" type="image/x-icon">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/3.5.0/remixicon.css">
    <link rel="stylesheet" href="../../stylesheets/User/swiper-bundle.min.css">
    <link rel="stylesheet" href="../../stylesheets/User/profile.css">
    <link rel="stylesheet" href="../../stylesheets/User/home.css">
    <title>User Profile | Book Mania</title>
    <style>
        .profile-header .personal-info { margin: 1rem; }
        .personal-info .card-body { padding: 1rem; }
        .info-item { margin-bottom: 1rem; display: flex; justify-content: space-between; align-items: center; }
        .info-label { font-weight: bold; color: #666; }
        .info-value-group { display: flex; align-items: center; gap: 0.5rem; }
        .info-value { color: #333; }
        .edit-btn, .add-btn {
            background: none;
            border: none;
            color: #007bff;
            cursor: pointer;
            padding: 0.2rem;
            font-size: 1rem;
        }
        .edit-btn:hover, .add-btn:hover { color: #0056b3; }
        .edit-field {
            display: none;
            margin-top: 0.5rem;
            gap: 0.5rem;
            align-items: center;
        }
        
        .edit-field.active {
            display: flex;
        }
        
        .info-item {
            position: relative;
            margin-bottom: 1.5rem;
        }
        
        .edit-field input,
        .edit-field select {
            padding: 0.5rem;
            border: 1px solid #ddd;
            border-radius: 4px;
            min-width: 200px;
        }
        
        .save-btn,
        .cancel-btn {
            padding: 0.5rem 1rem;
            border-radius: 4px;
            cursor: pointer;
            transition: all 0.3s ease;
        }
        
        .save-btn {
            background-color: #007bff;
            color: white;
            border: none;
        }
        
        .cancel-btn {
            background-color: #fff;
            border: 1px solid #ddd;
        }
        
        .save-btn:hover {
            background-color: #0056b3;
        }
        
        .cancel-btn:hover {
            background-color: #f8f9fa;
        }
    </style>
</head>
<body>
    <%- include('partials/navbar') %>

    <main class="main">
        <div class="profile-wrapper">
            <section class="profile-header">
                <div class="profile-cover">
                    <div class="profile-avatar-container">  
                        <img src="<%= userProfile && userProfile.profilePicture ? userProfile.profilePicture : '../../img/profile_default.avif' %>" alt="User Avatar" class="profile-avatar">
                        <form action="/upload-avatar" method="POST" enctype="multipart/form-data" class="avatar-upload-form">
                            <label for="avatar-input">
                                <i class="ri-camera-line"></i>
                            </label>
                            <input type="file" id="avatar-input" name="avatar" accept="image/*" hidden>
                            <button type="submit" hidden></button>
                        </form>
                    </div>
                </div>
                <div class="profile-info">
                    <h1 class="profile-name"><%= userProfile && userProfile.user && userProfile.user.name ? userProfile.user.name : 'Unknown User' %></h1>
                    <p class="profile-email"><%= userProfile && userProfile.user && userProfile.user.email ? userProfile.user.email : 'No email' %></p>
                </div>
                <section class="personal-info card">
                    <div class="card-header">
                        <h2>Personal Info</h2>
                    </div>
                    <div class="card-body">
                        <div class="info-item">
                            <span class="info-label">Mo No:</span>
                            <% if (userProfile && userProfile.phoneNumber) { %>
                                <div class="info-value-group">
                                    <span class="info-value"><%= userProfile.phoneNumber %></span>
                                    <button class="edit-btn" data-field="phone" onclick="showEditField('phone')">
                                        <i class="ri-edit-line"></i>
                                    </button>
                                </div>
                                <div class="edit-field" id="phone-edit">
                                    <input type="tel" value="<%= userProfile.phoneNumber %>" id="phone-input">
                                    <button class="save-btn" onclick="saveField('phone')">Save</button>
                                    <button class="cancel-btn" onclick="cancelEdit('phone')">Cancel</button>
                                </div>
                            <% } else { %>
                                <div class="info-value-group">
                                    <span class="info-value">Not provided</span>
                                    <button class="add-btn" onclick="showEditField('phone')">Add</button>
                                </div>
                                <div class="edit-field" id="phone-edit">
                                    <input type="tel" placeholder="Enter phone number" id="phone-input">
                                    <button class="save-btn" onclick="saveField('phone')">Save</button>
                                    <button class="cancel-btn" onclick="cancelEdit('phone')">Cancel</button>
                                </div>
                            <% } %>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Gender:</span>
                            <% if (userProfile && userProfile.gender) { %>
                                <div class="info-value-group">
                                    <span class="info-value"><%= userProfile.gender %></span>
                                    <button class="edit-btn" data-field="gender" onclick="showEditField('gender')">
                                        <i class="ri-edit-line"></i>
                                    </button>
                                </div>
                                <div class="edit-field" id="gender-edit">
                                    <select id="gender-input">
                                        <option value="male" <%= userProfile.gender === 'male' ? 'selected' : '' %>>Male</option>
                                        <option value="female" <%= userProfile.gender === 'female' ? 'selected' : '' %>>Female</option>
                                        <option value="other" <%= userProfile.gender === 'other' ? 'selected' : '' %>>Other</option>
                                    </select>
                                    <button class="save-btn" onclick="saveField('gender')">Save</button>
                                    <button class="cancel-btn" onclick="cancelEdit('gender')">Cancel</button>
                                </div>
                            <% } else { %>
                                <div class="info-value-group">
                                    <span class="info-value">Not specified</span>
                                    <button class="add-btn" onclick="showEditField('gender')">Add</button>
                                </div>
                                <div class="edit-field" id="gender-edit">
                                    <select id="gender-input">
                                        <option value="">Select gender</option>
                                        <option value="male">Male</option>
                                        <option value="female">Female</option>
                                        <option value="other">Other</option>
                                    </select>
                                    <button class="save-btn" onclick="saveField('gender')">Save</button>
                                    <button class="cancel-btn" onclick="cancelEdit('gender')">Cancel</button>
                                </div>
                            <% } %>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Joined:</span>
                            <span class="info-value"><%= userProfile && userProfile.user && userProfile.user.createdAt ? new Date(userProfile.user.createdAt).toLocaleDateString() : 'Unknown' %></span>
                        </div>
                        <% if (error) { %>
                            <p style="color: red;"><%= error %></p>
                        <% } %>
                    </div>
                </section>
            </section>

            <div class="profile-content">
                <div class="profile-main">
                    <section class="ordered-books-reviews card">
                        <div class="card-header">
                            <h2>Leave a Review</h2>
                        </div>
                        <div class="reviews-list">
                            <p>No orders found. (Add orderHistory to schema if needed)</p>
                        </div>
                    </section>
                </div>
                <div class="profile-sidebar">
                    <!-- Sidebar content can be added here if needed -->
                </div>
            </div>
        </div>
    </main>

    <script src="../../javascripts/scrollreveal.min.js"></script>
    <script src="../../javascripts/swiper-bundle.min.js"></script>
    <script src="../../javascripts/user/profile.js"></script>
    <script src="../../javascripts/user/home.js"></script>
    <script>
        const editProfileModal = document.getElementById('editProfileModal');
        const closeModalBtn = document.querySelector('.close-modal');
        const cancelBtn = document.querySelector('.cancel-btn');

        closeModalBtn.addEventListener('click', () => {
            editProfileModal.style.display = 'none';
        });

        cancelBtn.addEventListener('click', () => {
            editProfileModal.style.display = 'none';
        });

        window.addEventListener('click', (e) => {
            if (e.target === editProfileModal) {
                editProfileModal.style.display = 'none';
            }
        });

        const profileImageInput = document.getElementById('profile-image');
        const previewImage = document.getElementById('preview-image');

        profileImageInput.addEventListener('change', function() {
            const file = this.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    previewImage.src = e.target.result;
                };
                reader.readAsDataURL(file);
            }
        });

        // Update the showEditField and saveField functions in your script section
        function showEditField(field) {
            const editField = document.getElementById(`${field}-edit`);
            if (editField) {
                editField.style.display = 'flex';
                const input = document.getElementById(`${field}-input`);
                if (input) {
                    input.focus();
                }
            }
        }

        function cancelEdit(field) {
            const editField = document.getElementById(`${field}-edit`);
            if (editField) {
                editField.style.display = 'none';
                const input = document.getElementById(`${field}-input`);
                if (input) {
                    input.value = input.defaultValue;
                }
            }
        }

        async function saveField(field) {
            const input = document.getElementById(`${field}-input`);
            const value = input.value.trim();
            
            if (!value) {
                alert('Please enter a valid value');
                return;
            }

            try {
                const response = await fetch('/user/profile/update', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        [field === 'phone' ? 'phoneNumber' : field]: value
                    })
                });

                if (!response.ok) {
                    throw new Error('Server error');
                }

                const data = await response.json();
                
                if (data.success) {
                    // Hide the edit field
                    cancelEdit(field);
                    // Update the displayed value
                    const valueSpan = document.querySelector(`#${field}-edit`).previousElementSibling.querySelector('.info-value');
                    valueSpan.textContent = value;
                    // Show success message
                    alert('Updated successfully');
                } else {
                    throw new Error(data.error || 'Update failed');
                }
            } catch (error) {
                console.error('Update error:', error);
                alert('Failed to update profile. Please try again.');
            }
        }
    </script>
</body>
</html>