<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" href="assets/img/favicon.png" type="image/x-icon">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/3.5.0/remixicon.css">
    <link rel="stylesheet" href="../../stylesheets/User/swiper-bundle.min.css">
    <link rel="stylesheet" href="../../stylesheets/User/profile.css">
    <link rel="stylesheet" href="../../stylesheets/User/home.css">
    <title>User Profile | Book Mania</title>
    <style>
        .profile-header .personal-info {
    margin: 1rem;
}

.personal-info .card-body {
    padding: 1rem;
}

.info-item {
    margin-bottom: 1rem;
    display: flex;
    justify-content: space-between;
}

.info-label {
    font-weight: bold;
    color: #666;
}

.info-value {
    color: #333;
}
    </style>
</head>
<body>
    <%- include('partials/navbar') %>

    <main class="main">
        <div class="profile-wrapper">
            <section class="profile-header">
                <div class="profile-cover">
                    <div class="profile-avatar-container">  
                        <img src="../../img/profile_default.avif" alt="User Avatar" class="profile-avatar">
                        <form action="/upload-avatar" method="POST" enctype="multipart/form-data" class="avatar-upload-form">
                            <label for="avatar-input">
                                <i class="ri-camera-line"></i>
                            </label>
                            <input type="file" id="avatar-input" name="avatar" accept="image/*" hidden>
                            <button type="submit" hidden></button>
                        </form>
                    </div>
                </div>
                <!-- Replace hardcoded values with dynamic data -->
                <div class="profile-info">
                    <h1 class="profile-name"><%= userProfile.fullName %></h1>
                    <p class="profile-email"><%= userProfile.email %></p>
                </div>
                <section class="personal-info card">
                    <div class="card-body">
                        <div class="info-item">
                            <span class="info-label">Mo No:</span>
                            <div class="info-value-container">
                                <span class="info-value"><%= userProfile.phoneNumber || 'Not provided' %></span>
                                <button class="edit-btn" onclick="openEditField('phone')">
                                    <i class="ri-edit-line"></i>
                                </button>
                            </div>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Gender: </span>
                            <div class="info-value-container">
                                <span class="info-value"><%= userProfile.gender || 'Not specified' %></span>
                                <button class="edit-btn" onclick="openEditField('gender')">
                                    <i class="ri-edit-line"></i>
                                </button>
                            </div>
                        </div>
                        <div class="info-item">
                            <span class="info-label">Joined:</span>
                            <span class="info-value"><%= new Date(userProfile.memberSince).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) %></span>
                        </div>
                    </div>
                </section>
            </section>

            <div class="profile-content">
                <div class="profile-main">
                    <section class="ordered-books-reviews card">
                        <div class="card-header">
                            <h2>Leave a Review</h2>
                        </div>
                        <div class="reviews-list">
                            <div class="review-item">
                                <div class="book-info">
                                    <img src="../../img/book-1.png" alt="Book" class="book-thumbnail">
                                    <div class="book-details">
                                        <h3>The Mystery Unraveled</h3>
                                        <p class="order-date">Ordered on: March 10, 2025</p>
                                        <p class="delivery-date">Delivered on: March 15, 2025</p>
                                    </div>
                                </div>
                                <form action="/submit-review" method="POST" class="review-content">
                                    <input type="hidden" name="bookId" value="book1">
                                    <div class="rating">
                                        <select name="rating" required>
                                            <option value="5">★★★★★</option>
                                            <option value="4">★★★★☆</option>
                                            <option value="3">★★★☆☆</option>
                                            <option value="2">★★☆☆☆</option>
                                            <option value="1">★☆☆☆☆</option>
                                        </select>
                                    </div>
                                    <textarea name="reviewText" placeholder="Write your review..." required></textarea>
                                    <button type="submit" class="save-btn">Submit Review</button>
                                </form>
                            </div>

                            <div class="review-item">
                                <div class="book-info">
                                    <img src="../../img/book-2.png" alt="Book" class="book-thumbnail">
                                    <div class="book-details">
                                        <h3>Galactic Adventures</h3>
                                        <p class="order-date">Ordered on: March 5, 2025</p>
                                        <p class="delivery-date">Delivered on: March 12, 2025</p>
                                    </div>
                                </div>
                                <form action="/submit-review" method="POST" class="review-content">
                                    <input type="hidden" name="bookId" value="book2">
                                    <div class="rating">
                                        <select name="rating" required>
                                            <option value="5">★★★★★</option>
                                            <option value="4">★★★★☆</option>
                                            <option value="3">★★★☆☆</option>
                                            <option value="2">★★☆☆☆</option>
                                            <option value="1">★☆☆☆☆</option>
                                        </select>
                                    </div>
                                    <textarea name="reviewText" placeholder="Write your review..." required></textarea>
                                    <button type="submit" class="save-btn">Submit Review</button>
                                </form>
                            </div>
                        </div>
                    </section>
                </div>

                <div class="profile-sidebar">
                    <!-- Sidebar content can be added here if needed -->
                </div>
            </div>
        </div>
    </main>

    <div class="edit-profile-modal" id="editProfileModal">
        <div class="modal-content">
            <form class="edit-profile-form" action="/update-profile" method="POST" enctype="multipart/form-data">
                <div class="modal-header">
                    <h3>Edit Profile</h3>
                    <button type="button" class="close-modal">
                        <i class="ri-close-line"></i>
                    </button>
                </div>
                
                <div class="form-group">
                    <label for="profile-image">Profile Image</label>
                    <div class="image-upload">
                        <img id="preview-image" src="../../img/user-avatar.png" alt="Preview">
                        <input type="file" id="profile-image" name="profileImage" accept="image/*">
                        <label for="profile-image" class="upload-label">
                            <i class="ri-camera-line"></i>
                            Choose Image
                        </label>
                    </div>
                </div>

                <div class="form-group">
                    <label for="profile-name">Full Name</label>
                    <input type="text" id="profile-name" name="name" value="John Doe" required>
                </div>

                <div class="form-group">
                    <label for="profile-email">Email</label>
                    <input type="email" id="profile-email" name="email" value="john.doe@email.com" required>
                </div>

                <div class="modal-actions">
                    <button type="button" class="cancel-btn">Cancel</button>
                    <button type="submit" class="save-btn">Save Changes</button>
                </div>
            </form>
        </div>
    </div>

    <script src="../../javascripts/scrollreveal.min.js"></script>
    <script src="../../javascripts/swiper-bundle.min.js"></script>
    <script src="../../javascripts/user/profile.js"></script>
    <script src="../../javascripts/user/home.js"></script>
    <script>
        // Modal handling
        const editProfileModal = document.getElementById('editProfileModal');
        const closeModalBtn = document.querySelector('.close-modal');
        const cancelBtn = document.querySelector('.cancel-btn');

        // Close modal
        closeModalBtn.addEventListener('click', () => {
            editProfileModal.style.display = 'none';
        });

        cancelBtn.addEventListener('click', () => {
            editProfileModal.style.display = 'none';
        });

        // Close modal when clicking outside
        window.addEventListener('click', (e) => {
            if (e.target === editProfileModal) {
                editProfileModal.style.display = 'none';
            }
        });

        // Image preview
        const profileImageInput = document.getElementById('profile-image');
        const previewImage = document.getElementById('preview-image');

        profileImageInput.addEventListener('change', function() {
            const file = this.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    previewImage.src = e.target.result;
                }
                reader.readAsDataURL(file);
            }
        });
    </script>

    <!-- Add edit modals -->
    <div class="edit-field-modal" id="phoneEditModal">
        <div class="modal-content">
            <!-- Update the form action paths -->
            <form action="/profile/update-profile/phone" method="POST">
                <h3>Edit Phone Number</h3>
                <input type="tel" name="phoneNumber" pattern="[0-9]{10}" value="<%= userProfile.phoneNumber || '' %>" required>
                <div class="modal-actions">
                    <button type="button" class="cancel-btn" onclick="closeEditField('phone')">Cancel</button>
                    <button type="submit" class="save-btn">Save</button>
                </div>
            </form>
        </div>
    </div>

    <div class="edit-field-modal" id="genderEditModal">
        <div class="modal-content">
            <form action="/profile/update-profile/gender" method="POST">
                <h3>Edit Gender</h3>
                <select name="gender" required>
                    <option value="male" <%= userProfile.gender === 'male' ? 'selected' : '' %>>Male</option>
                    <option value="female" <%= userProfile.gender === 'female' ? 'selected' : '' %>>Female</option>
                    <option value="other" <%= userProfile.gender === 'other' ? 'selected' : '' %>>Other</option>
                </select>
                <div class="modal-actions">
                    <button type="button" class="cancel-btn" onclick="closeEditField('gender')">Cancel</button>
                    <button type="submit" class="save-btn">Save</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Add these styles to your existing <style> section -->
    <style>
        .info-value-container {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .edit-btn {
            background: none;
            border: none;
            cursor: pointer;
            color: #666;
            padding: 0;
            font-size: 1rem;
        }

        .edit-btn:hover {
            color: #333;
        }

        .edit-field-modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            z-index: 1000;
        }

        .edit-field-modal .modal-content {
            background: white;
            padding: 20px;
            border-radius: 8px;
            width: 90%;
            max-width: 400px;
            margin: 20% auto;
        }

        .edit-field-modal input,
        .edit-field-modal select {
            width: 100%;
            padding: 8px;
            margin: 10px 0;
            border: 1px solid #ddd;
            border-radius: 4px;
        }

        .modal-actions {
            display: flex;
            justify-content: flex-end;
            gap: 10px;
            margin-top: 15px;
        }
    </style>

    <!-- Add this script at the end of your file -->
    <script>
        function openEditField(field) {
            document.getElementById(`${field}EditModal`).style.display = 'block';
        }

        function closeEditField(field) {
            document.getElementById(`${field}EditModal`).style.display = 'none';
        }

        // Close modals when clicking outside
        window.addEventListener('click', (e) => {
            const phoneModal = document.getElementById('phoneEditModal');
            const genderModal = document.getElementById('genderEditModal');
            
            if (e.target === phoneModal) {
                phoneModal.style.display = 'none';
            }
            if (e.target === genderModal) {
                genderModal.style.display = 'none';
            }
        });
    </script>
</body>
</html>