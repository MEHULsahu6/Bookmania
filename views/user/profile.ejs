<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" href="assets/img/favicon.png" type="image/x-icon">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/3.5.0/remixicon.css">
    <link rel="stylesheet" href="../../stylesheets/User/swiper-bundle.min.css">
    <link rel="stylesheet" href="../../stylesheets/User/home.css">
    <link rel="stylesheet" href="../../stylesheets/User/profile.css">
    <title>User Profile | Book Mania</title>
</head>
<body>
    <%- include('partials/navbar') %>

    <main class="main">
        <div class="profile-wrapper">
            <!-- Profile Header -->
            <section class="profile-header">
                <div class="profile-cover">
                    <div class="profile-avatar-container">
                        <img src="../../img/user-avatar.png" alt="User Avatar" class="profile-avatar">
                        <div class="avatar-upload">
                            <label for="avatar-input">
                                <i class="ri-camera-line"></i>
                            </label>
                            <input type="file" id="avatar-input" hidden>
                        </div>
                    </div>
                </div>
                <div class="profile-info">
                    <h1 class="profile-name">John Doe</h1>
                    <p class="profile-email">john.doe@email.com</p>
                    <div class="profile-stats">
                        <div class="stat-item">
                            <span class="stat-value">42</span>
                            <span class="stat-label">Books Read</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-value">15</span>
                            <span class="stat-label">Wishlist</span>
                        </div>
                        <div class="stat-item">
                            <span class="stat-value">8</span>
                            <span class="stat-label">Reviews</span>
                        </div>
                    </div>
                </div>
            </section>

            <!-- Profile Content -->
            <div class="profile-content">
                <!-- Left Column -->
                <div class="profile-main">
                    <section class="profile-about card">
                        <div class="card-header">
                            <h2>About Me</h2>
                            <button class="edit-btn" id="edit-about">
                                <i class="ri-edit-line"></i>
                            </button>
                        </div>
                        <div class="card-body">
                            <p class="profile-bio">
                                Avid reader and book enthusiast. I love exploring different genres, 
                                especially mystery and science fiction. Always on the lookout for 
                                my next great read!
                            </p>
                        </div>
                    </section>

                    <section class="profile-favorites card">
                        <div class="card-header">
                            <h2>Favorite Books</h2>
                            <button class="view-all-btn">View All</button>
                        </div>
                        <div class="favorites-grid">
                            <div class="book-card">
                                <img src="../../img/book-1.png" alt="Book">
                                <div class="book-info">
                                    <h3>Book Title 1</h3>
                                    <div class="book-rating">
                                        <i class="ri-star-fill"></i>
                                        <span>4.5</span>
                                    </div>
                                </div>
                            </div>
                            <!-- Add more book cards -->
                        </div>
                    </section>
                </div>

                <!-- Right Column -->
                <div class="profile-sidebar">
                    <section class="profile-actions card">
                        <button class="action-btn primary">
                            <i class="ri-edit-line"></i>
                            Edit Profile
                        </button>
                        <button class="action-btn">
                            <i class="ri-settings-3-line"></i>
                            Settings
                        </button>
                    </section>

                    <section class="recent-activity card">
                        <div class="card-header">
                            <h2>Recent Activity</h2>
                        </div>
                        <div class="activity-list">
                            <div class="activity-item">
                                <div class="activity-icon">
                                    <i class="ri-book-read-line"></i>
                                </div>
                                <div class="activity-details">
                                    <h4>Finished Reading</h4>
                                    <p>"Mystery of the Lost City"</p>
                                    <span class="activity-date">March 15, 2025</span>
                                </div>
                            </div>
                            <!-- Add more activity items -->
                        </div>
                    </section>
                </div>
            </div>
        </div>
    </main>


    <div class="edit-profile-modal" id="editProfileModal">
        <div class="modal-content">
            <form class="edit-profile-form" action="/update-profile" method="POST" enctype="multipart/form-data">
                <div class="modal-header">
                    <h3>Edit Profile</h3>
                    <button type="button" class="close-modal">
                        <i class="ri-close-line"></i>
                    </button>
                </div>
                
                <div class="form-group">
                    <label for="profile-image">Profile Image</label>
                    <div class="image-upload">
                        <img id="preview-image" src="../../img/user-avatar.png" alt="Preview">
                        <input type="file" id="profile-image" name="profileImage" accept="image/*">
                        <label for="profile-image" class="upload-label">
                            <i class="ri-camera-line"></i>
                            Choose Image
                        </label>
                    </div>
                </div>

                <div class="form-group">
                    <label for="profile-name">Full Name</label>
                    <input type="text" id="profile-name" name="name" value="John Doe" required>
                </div>

                <div class="form-group">
                    <label for="profile-email">Email</label>
                    <input type="email" id="profile-email" name="email" value="john.doe@email.com" required>
                </div>

                <div class="modal-actions">
                    <button type="button" class="cancel-btn">Cancel</button>
                    <button type="submit" class="save-btn">Save Changes</button>
                </div>
            </form>
        </div>
    </div>

    <script src="javascripts/scrollreveal.min.js"></script>
    <script src="javascripts/swiper-bundle.min.js"></script>
    <script src="javascripts/home.js"></script>
    <script src="javascripts/profile.js"></script>
</body>
</html>