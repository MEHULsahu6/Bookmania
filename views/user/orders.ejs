<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" href="/img/favicon.png" type="image/x-icon">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/3.5.0/remixicon.css">
    <link rel="stylesheet" href="/stylesheets/User/home.css">
    <link rel="stylesheet" href="/stylesheets/User/orders.css">
</head>
<body>
    <%- include('partials/navbar') %>

    <main class="main">
        <section class="orders section">
            <h2 class="section__title">My Orders</h2>

            <div class="orders__container container">
                <% if (!orders || orders.length === 0) { %>
                    <div class="orders__empty">
                        <img src="/img/empty-orders.png" alt="No orders" class="empty__img">
                        <h3 class="empty__title">No orders yet</h3>
                        <p class="empty__description">Start shopping and make your first order!</p>
                        <a href="/explore" class="button">Explore Books</a>
                    </div>
                <% } else { %>
                    <div class="orders__content">
                        <% orders.forEach(order => { %>
                            <div class="order__card">
                                <div class="order__header">
                                    <div class="order__info">
                                        <h3 class="order__id">Order #<%= order.orderId %></h3>
                                        <span class="order__date">
                                            <%= new Date(order.orderDate).toLocaleDateString() %>
                                        </span>
                                    </div>
                                    <span class="order__status <%= order.status %>">
                                        <%= order.status.charAt(0).toUpperCase() + order.status.slice(1) %>
                                    </span>
                                </div>

                                <div class="order__products">
                                    <% order.books.forEach(item => { %>
                                        <div class="product__item">
                                            <img src="<%= item.book.image %>" alt="<%= item.book.title %>" class="product__img">
                                            <div class="product__details">
                                                <h4 class="product__title"><%= item.book.title %></h4>
                                                <p class="product__price">$<%= item.price.toFixed(2) %> x <%= item.quantity %></p>
                                            
                                                <% const reviewKey = `${order._id}-${item.book._id}`; %>
                                                <% if (!reviewMap[reviewKey]) { %>
                                                    <button class="review-btn" 
                                                            onclick="openReviewModal('<%= order._id %>', '<%= item.book._id %>', '<%= item.book.title %>')">
                                                        Write Review
                                                    </button>
                                                <% } else { %>
                                                    <div class="review-status <%= reviewMap[reviewKey].status %>">
                                                        Review <%= reviewMap[reviewKey].status %>
                                                    </div>
                                                <% } %>
                                            </div>
                                        </div>
                                    <% }); %>
                                </div>

                                <div class="order__footer">
                                    <div class="order__total">
                                        <span>Total Amount:</span>
                                        <span class="total__amount">$<%= order.totalAmount.toFixed(2) %></span>
                                    </div>
                                    <a href="/orders/<%= order.orderId %>" class="button order__details">View Details</a>
                                </div>
                            </div>
                        <% }); %>
                    </div>
                <% } %>
            </div>
        </section>
    </main>

    <script src="/javascripts/user/home.js"></script>
</body>
</html>

<!-- Review Modal -->
<div id="reviewModal" class="modal">
    <div class="modal-content">
        <span class="close">&times;</span>
        <h2>Write a Review</h2>
        <form id="reviewForm">
            <input type="hidden" id="orderId" name="orderId">
            <input type="hidden" id="bookId" name="bookId">
            
            <div class="rating-input">
                <span>Rating:</span>
                <div class="stars">
                    <% for(let i = 5; i >= 1; i--) { %>
                        <input type="radio" id="star<%= i %>" name="rating" value="<%= i %>">
                        <label for="star<%= i %>"></label>
                    <% } %>
                </div>
            </div>
            
            <div class="comment-input">
                <label for="comment">Your Review:</label>
                <textarea id="comment" name="comment" required></textarea>
            </div>
            
            <button type="submit" class="submit-review">Submit Review</button>
        </form>
    </div>
</div>

<script>
function openReviewModal(orderId, bookId, bookTitle) {
    const modal = document.getElementById('reviewModal');
    document.getElementById('orderId').value = orderId;
    document.getElementById('bookId').value = bookId;
    modal.style.display = 'block';
}

document.querySelector('.close').onclick = function() {
    document.getElementById('reviewModal').style.display = 'none';
}

document.getElementById('reviewForm').onsubmit = async function(e) {
    e.preventDefault();
    
    const formData = {
        orderId: document.getElementById('orderId').value,
        bookId: document.getElementById('bookId').value,
        rating: document.querySelector('input[name="rating"]:checked').value,
        comment: document.getElementById('comment').value
    };

    try {
        const response = await fetch('/orders/review', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(formData)
        });

        const data = await response.json();
        if (data.success) {
            alert('Review submitted successfully!');
            location.reload();
        } else {
            alert('Error submitting review: ' + data.message);
        }
    } catch (error) {
        alert('Error submitting review');
    }
};
</script>