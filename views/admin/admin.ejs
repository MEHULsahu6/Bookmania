<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" href="assets/img/favicon.png" type="image/x-icon">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/3.5.0/remixicon.css">
    <link rel="stylesheet" href="../../stylesheets/Admin/admin.css">
    <title>Admin Dashboard</title>
</head>
<body>
    <%- include('./components/navbar') %>
    <%- include('./components/sidebar') %>

    <main class="main">
        <div class="main__container container">
            <!-- Statistics Cards -->
            <section class="stats section">
                <h2 class="section__title">Dashboard Overview</h2>
                <div class="stats__container grid">
                    <div class="stats__card">
                        <i class="ri-book-line"></i>
                        <h3>Total Books</h3>
                        <p><%= stats.totalBooks %></p>
                    </div>
                    <div class="stats__card">
                        <i class="ri-shopping-cart-line"></i>
                        <h3>Total Orders</h3>
                        <p><%= stats.totalOrders %></p>
                    </div>
                    <div class="stats__card">
                        <i class="ri-time-line"></i>
                        <h3>Pending Orders</h3>
                        <p><%= stats.pendingOrders %></p>
                    </div>
                    <div class="stats__card">
                        <i class="ri-user-line"></i>
                        <h3>Total Users</h3>
                        <p><%= stats.totalUsers %></p>
                    </div>
                    <div class="stats__card">
                        <i class="ri-message-3-line"></i>
                        <h3>Pending Reviews</h3>
                        <p><%= stats.pendingReviews %></p>
                    </div>
                    <div class="stats__card">
                        <i class="ri-money-dollar-circle-line"></i>
                        <h3>Total Revenue</h3>
                        <p>$<%= stats.totalRevenue.toFixed(2) %></p>
                    </div>
                </div>
            </section>

            <!-- Recent Orders -->
            <section class="recent-orders section">
                <h2 class="section__title">Recent Orders</h2>
                <div class="table__container">
                    <table class="table">
                        <thead>
                            <tr>
                                <th>Order ID</th>
                                <th>Customer</th>
                                <th>Amount</th>
                                <th>Status</th>
                                <th>Date</th>
                            </tr>
                        </thead>
                        <tbody>
                            <% recentOrders.forEach(order => { %>
                                <tr>
                                    <td><%= order._id %></td>
                                    <td><%= order.user.name %></td>
                                    <td>$<%= order.totalAmount.toFixed(2) %></td>
                                    <td><span class="status <%= order.status %>"><%= order.status %></span></td>
                                    <td><%= new Date(order.createdAt).toLocaleDateString() %></td>
                                </tr>
                            <% }) %>
                        </tbody>
                    </table>
                </div>
            </section>

            <!-- Recent Reviews -->
            <section class="recent-reviews section">
                <h2 class="section__title">Recent Reviews</h2>
                <div class="reviews__container">
                    <% recentReviews.forEach(review => { %>
                        <div class="review__card">
                            <div class="review__header">
                                <h4><%= review.user.name %></h4>
                                <span class="review__date">
                                    <%= new Date(review.createdAt).toLocaleDateString() %>
                                </span>
                            </div>
                            <p class="review__book">Book: <%= review.book.title %></p>
                            <div class="review__rating">
                                <% for(let i = 0; i < review.rating; i++) { %>
                                    <i class="ri-star-fill"></i>
                                <% } %>
                            </div>
                            <p class="review__comment"><%= review.comment %></p>
                        </div>
                    <% }) %>
                </div>
            </section>
        </div>
    </main>

    <script src="../../javascripts/admin.js"></script>
    <script src="../../javascripts/admin/theme.js"></script>
</body>
</html>