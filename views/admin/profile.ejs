<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" href="assets/img/favicon.png" type="image/x-icon">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/3.5.0/remixicon.css">
    <link rel="stylesheet" href="../../stylesheets/Admin/admin.css">
    <link rel="stylesheet" href="../../stylesheets/Admin/profile.css">
    <title>Profile - Admin Panel</title>
</head>
<body>
    <%- include('./components/navbar') %>
    <%- include('./components/sidebar') %>

    <main class="main">
        <div class="main__container container">
            <section class="profile section">
                <h2 class="section__title">Profile Settings</h2>
                
                <div class="profile__container">
                    <!-- Profile Header -->
                    <div class="profile__header">
                        <div class="profile__avatar">
                            <img src="../../img/admin-avatar.png" alt="Admin Avatar">
                            <button class="change-avatar-btn">
                                <i class="ri-camera-line"></i>
                            </button>
                        </div>
                        <div class="profile__info">
                            <h3>John Doe</h3>
                            <p>Administrator</p>
                            <span>Member since: January 2024</span>
                        </div>
                    </div>

                    <!-- Profile Form -->
                    <form class="profile__form">
                        <div class="form__grid">
                            <!-- Personal Information -->
                            <div class="form__section">
                                <h4>Personal Information</h4>
                                <div class="form__group">
                                    <label for="fullName">Full Name</label>
                                    <input type="text" id="fullName" value="John Doe">
                                </div>
                                <div class="form__group">
                                    <label for="email">Email Address</label>
                                    <input type="email" id="email" value="john@example.com">
                                </div>
                                <div class="form__group">
                                    <label for="phone">Phone Number</label>
                                    <input type="tel" id="phone" value="+1 234 567 890">
                                </div>
                            </div>

                            <!-- Security Settings -->
                            <div class="form__section">
                                <h4>Security Settings</h4>
                                <div class="form__group">
                                    <label for="currentPassword">Current Password</label>
                                    <input type="password" id="currentPassword">
                                </div>
                                <div class="form__group">
                                    <label for="newPassword">New Password</label>
                                    <input type="password" id="newPassword">
                                </div>
                                <div class="form__group">
                                    <label for="confirmPassword">Confirm New Password</label>
                                    <input type="password" id="confirmPassword">
                                </div>
                            </div>

                            <!-- Preferences -->
                            <div class="form__section">
                                <h4>Preferences</h4>
                                <div class="form__group">
                                    <label class="checkbox-label">
                                        <input type="checkbox" checked>
                                        Email Notifications
                                    </label>
                                </div>
                                <div class="form__group">
                                    <label class="checkbox-label">
                                        <input type="checkbox" checked>
                                        Two-Factor Authentication
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="form__actions">
                            <button type="button" class="cancel-btn">Cancel</button>
                            <button type="submit" class="save-btn">Save Changes</button>
                        </div>
                    </form>
                </div>
            </section>
        </div>
    </main>

    <script src="../../javascripts/admin.js"></script>
</body>
</html>