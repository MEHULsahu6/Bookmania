<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" href="/assets/img/favicon.png" type="image/x-icon">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/3.5.0/remixicon.css">
    <link rel="stylesheet" href="/stylesheets/Admin/admin.css">
    <link rel="stylesheet" href="/stylesheets/Admin/profile.css">
    <title>Profile - Admin Panel</title>
</head>
<body>
    <%- include('./components/navbar') %>
    <%- include('./components/sidebar') %>

    <main class="main">
        <div class="main__container container">
            <section class="profile section">
                <h2 class="section__title">Profile Settings</h2>
                
                <% if (error) { %>
                    <div class="error-message" style="color: #ff4444; text-align: center;"><%= error %></div>
                <% } %>

                <div class="profile__container">
                    <!-- Profile Header -->
                    <div class="profile__header">
                        <div class="profile__avatar">
                            <img src="<%= adminProfile && adminProfile.profilePicture ? adminProfile.profilePicture : '/img/admin-avatar.png' %>" alt="Admin Avatar">
                            <button class="change-avatar-btn" onclick="alert('Image upload not implemented yet')">
                                <i class="ri-camera-line"></i>
                            </button>
                        </div>
                        <div class="profile__info">
                            <h3><%= user ? user.name : 'Unknown' %></h3>
                            <p>Administrator</p>
                            <span>Member since: <%= user ? new Date(user.createdAt).toLocaleDateString() : 'N/A' %></span>
                        </div>
                    </div>

                    <!-- Profile Form -->
                    <form class="profile__form" action="/admin/profile/update" method="POST">
                        <div class="form__grid">
                            <!-- Personal Information -->
                            <div class="form__section">
                                <h4>Personal Information</h4>
                                <div class="form__group">
                                    <label for="fullName">Full Name</label>
                                    <input type="text" id="fullName" name="fullName" value="<%= user ? user.name : '' %>" required>
                                </div>
                                <div class="form__group">
                                    <label for="email">Email Address</label>
                                    <input type="email" id="email" name="email" value="<%= user ? user.email : '' %>" required>
                                </div>
                                <div class="form__group">
                                    <label for="phone">Phone Number</label>
                                    <input type="tel" id="phone" name="phoneNumber" value="<%= adminProfile ? adminProfile.phoneNumber : '' %>" required>
                                </div>
                            </div>

                            <!-- Personal Details -->
                            <div class="form__section">
                                <div class="form__group" style="margin-top: 40px;">
                                    <label for="address">Address</label>
                                    <input type="text" id="address" name="address" value="<%= adminProfile ? adminProfile.address : '' %>">
                                </div>
                                <div class="form__group">
                                    <label for="city">City</label>
                                    <input type="text" id="city" name="city" value="<%= adminProfile ? adminProfile.city : '' %>">
                                </div>
                            </div>
                        </div>

                        <div class="form__actions">
                            <button type="button" class="cancel-btn" onclick="window.location.reload()">Cancel</button>
                            <button type="submit" class="save-btn">Save Changes</button>
                        </div>
                    </form>
                </div>
            </section>
        </div>
    </main>

    <script src="/javascripts/admin.js"></script>
    <script>
        // Basic client-side validation
        document.querySelector('.profile__form').addEventListener('submit', (e) => {
            const phone = document.getElementById('phone').value;
            const email = document.getElementById('email').value;
            
            if (!/^\+?[1-9]\d{1,14}$/.test(phone)) {
                e.preventDefault();
                alert('Please enter a valid phone number');
            }
            
            if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
                e.preventDefault();
                alert('Please enter a valid email address');
            }
        });
    </script>
</body>
</html>