<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" href="assets/img/favicon.png" type="image/x-icon">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/3.5.0/remixicon.css">
    <link rel="stylesheet" href="../../stylesheets/Admin/admin.css">
    <link rel="stylesheet" href="../../stylesheets/Admin/reviews.css">
    <title>Reviews - Admin Panel</title>
</head>
<body>
    <%- include('./components/navbar') %>
    <%- include('./components/sidebar') %>

    <main class="main">
        <div class="main__container container">
            <section class="reviews section">
                <h2 class="section__title">Reviews Management</h2>

                <div class="reviews__container">
                    <div class="reviews__filters">
                        <div class="search-box">
                            <i class="ri-search-line"></i>
                            <input type="text" placeholder="Search reviews...">
                        </div>
                        <div class="filter-group">
                            <select class="filter-rating">
                                <option value="all">All Ratings</option>
                                <option value="5">5 Stars</option>
                                <option value="4">4 Stars</option>
                                <option value="3">3 Stars</option>
                                <option value="2">2 Stars</option>
                                <option value="1">1 Star</option>
                            </select>
                            <select class="filter-status">
                                <option value="all">All Status</option>
                                <option value="pending">Pending</option>
                                <option value="approved">Approved</option>
                                <option value="rejected">Rejected</option>
                            </select>
                        </div>
                    </div>

                    <div class="reviews__list">
                        <% if (reviews && reviews.length > 0) { %>
                            <% reviews.forEach(review => { %>
                                <div class="review-card">
                                    <div class="review-header">
                                        <div class="user-info">
                                            <img src="<%= review.user.profilePicture || '../../img/default-avatar.png' %>" alt="User">
                                            <div>
                                                <h4><%= review.user.name %></h4>
                                                <span>Posted on <%= new Date(review.createdAt).toLocaleDateString() %></span>
                                            </div>
                                        </div>
                                        <span class="review-status <%= review.status %>">
                                            <%= review.status.charAt(0).toUpperCase() + review.status.slice(1) %>
                                        </span>
                                    </div>

                                    <div class="review-content">
                                        <div class="book-info">
                                            <img src="<%= review.book.image %>" alt="<%= review.book.title %>">
                                            <div>
                                                <h5><%= review.book.title %></h5>
                                                <div class="rating">
                                                    <% for(let i = 0; i < review.rating; i++) { %>
                                                        <i class="ri-star-fill"></i>
                                                    <% } %>
                                                    <% for(let i = review.rating; i < 5; i++) { %>
                                                        <i class="ri-star-line"></i>
                                                    <% } %>
                                                    <span><%= review.rating %>.0</span>
                                                </div>
                                            </div>
                                        </div>
                                        <p class="review-text"><%= review.comment %></p>
                                    </div>

                                    <div class="review-actions">
                                        <% if (review.status === 'pending') { %>
                                            <button class="approve-btn" onclick="updateReviewStatus('<%= review._id %>', 'approved')">
                                                <i class="ri-check-line"></i> Approve
                                            </button>
                                            <button class="reject-btn" onclick="updateReviewStatus('<%= review._id %>', 'rejected')">
                                                <i class="ri-close-line"></i> Reject
                                            </button>
                                        <% } %>
                                        <button class="delete-btn" onclick="deleteReview('<%= review._id %>')">
                                            <i class="ri-delete-bin-line"></i> Delete
                                        </button>
                                    </div>
                                </div>
                            <% }); %>
                        <% } else { %>
                            <div class="no-reviews">
                                <i class="ri-file-list-3-line"></i>
                                <h3>No Reviews Found</h3>
                                <p>There are no reviews to display at the moment.</p>
                            </div>
                        <% } %>
                    </div>
                </div>
            </section>
        </div>
    </main>

    <script>
    async function updateReviewStatus(reviewId, status) {
        try {
            const response = await fetch('/admin/reviews/update-status', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ reviewId, status })
            });

            const data = await response.json();
            if (data.success) {
                location.reload();
            } else {
                alert('Error updating review status');
            }
        } catch (error) {
            alert('Error updating review status');
        }
    }

    async function deleteReview(reviewId) {
        if (!confirm('Are you sure you want to delete this review?')) return;

        try {
            const response = await fetch(`/admin/reviews/${reviewId}`, {
                method: 'DELETE'
            });

            const data = await response.json();
            if (data.success) {
                location.reload();
            } else {
                alert('Error deleting review');
            }
        } catch (error) {
            alert('Error deleting review');
        }
    }
    </script>

    <script src="../../javascripts/admin.js"></script>
</body>
</html>