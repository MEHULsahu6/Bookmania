<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" href="assets/img/favicon.png" type="image/x-icon">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/3.5.0/remixicon.css">
    <link rel="stylesheet" href="../../stylesheets/Admin/admin.css">
    <link rel="stylesheet" href="../../stylesheets/Admin/reviews.css">
    <title>Reviews - Admin Panel</title>
</head>
<body>
    <%- include('./components/navbar') %>
    <%- include('./components/sidebar') %>

    <main class="main">
        <div class="main__container container">
            <section class="reviews section">
                <div class="reviews__header">
                    <h2 class="section__title">Book Reviews</h2>
                    <div class="reviews__filters">
                        <div class="search-box">
                            <i class="ri-search-line"></i>
                            <input type="text" id="searchReviews" placeholder="Search reviews...">
                        </div>
                        <select id="ratingFilter">
                            <option value="">All Ratings</option>
                            <option value="5">5 Stars</option>
                            <option value="4">4 Stars</option>
                            <option value="3">3 Stars</option>
                            <option value="2">2 Stars</option>
                            <option value="1">1 Star</option>
                        </select>
                    </div>
                </div>

                <div class="reviews__container">
                    <% if (reviews && reviews.length > 0) { %>
                        <% reviews.forEach(review => { %>
                            <div class="review__card">
                                <div class="review__header">
                                    <div class="book__info">
                                        <img src="<%= review.book.image %>" alt="<%= review.book.title %>">
                                        <h3><%= review.book.title %></h3>
                                    </div>
                                    <div class="rating">
                                        <% for(let i = 1; i <= 5; i++) { %>
                                            <i class="ri-star-<%= i <= review.rating ? 'fill' : 'line' %>"></i>
                                        <% } %>
                                    </div>
                                </div>
                                <div class="review__content">
                                    <p><%= review.comment %></p>
                                </div>
                                <div class="review__footer">
                                    <div class="reviewer">
                                        <i class="ri-user-line"></i>
                                        <span><%= review.user.name %></span>
                                    </div>
                                    <div class="review__date">
                                        <%= new Date(review.createdAt).toLocaleDateString() %>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    <% } else { %>
                        <div class="no-reviews">
                            <i class="ri-chat-3-line"></i>
                            <p>No reviews found</p>
                        </div>
                    <% } %>
                </div>
            </section>
        </div>
    </main>

    <script src="../../javascripts/admin.js"></script>
    <script src="../../javascripts/admin/theme.js"></script>
</body>
</html>