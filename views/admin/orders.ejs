<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="shortcut icon" href="assets/img/favicon.png" type="image/x-icon">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/3.5.0/remixicon.css">
    <link rel="stylesheet" href="../../stylesheets/Admin/admin.css">
    <link rel="stylesheet" href="../../stylesheets/Admin/orders.css">
    <title>Orders - Admin Panel</title>
</head>
<body>
    <%- include('./components/navbar') %>
    <%- include('./components/sidebar') %>

    <main class="main">
        <div class="main__container container">
            <section class="orders section">
                <div class="orders__header">
                    <h2 class="section__title">Orders Management</h2>
                    <div class="orders__actions">
                        <div class="search-box">
                            <i class="ri-search-line"></i>
                            <input type="text" placeholder="Search orders...">
                        </div>
                        <div class="filter-box">
                            <select id="statusFilter">
                                <option value="">All Status</option>
                                <option value="pending">Pending</option>
                                <option value="processing">Processing</option>
                                <option value="shipped">Shipped</option>
                                <option value="delivered">Delivered</option>
                                <option value="cancelled">Cancelled</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="orders__container">
                    

                    <div class="table-container">
                        <table class="orders__table">
                            <thead>
                                <tr>
                                    <th>
                                        <input type="checkbox" id="selectAll">
                                    </th>
                                    <th>Order ID</th>
                                    <th>Customer</th>
                                    <th>Products</th>
                                    <th>Date</th>
                                    <th>Total</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- Sample Order Row -->
                                <tr>
                                    <td><input type="checkbox" class="order-select"></td>
                                    <td>#ORD-2024-001</td>
                                    <td>
                                        <div class="customer-info">
                                            <div>
                                                <h4>John Doe</h4>
                                                <span>john@example.com</span>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="product-preview">
                                            <img src="../../img/book-1.png" alt="Book">
                                            
                                        </div>
                                    </td>
                                    <td>Jan 15, 2024</td>
                                    <td>$89.99</td>
                                  
                                    <td>
                                        <div class="action-buttons">
                                           
                                            <button class="delete-btn" title="Delete Order">
                                                <i class="ri-delete-bin-line"></i>
                                            </button>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <div class="pagination">
                        <button class="prev-btn"><i class="ri-arrow-left-s-line"></i></button>
                        <div class="page-numbers">
                            <button class="active">1</button>
                            <button>2</button>
                            <button>3</button>
                            <span>...</span>
                            <button>10</button>
                        </div>
                        <button class="next-btn"><i class="ri-arrow-right-s-line"></i></button>
                    </div>
                </div>
            </section>
        </div>
    </main>

    <script src="../../javascripts/admin.js"></script>
</body>
</html>