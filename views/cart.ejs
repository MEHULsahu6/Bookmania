<!DOCTYPE html>
<html lang="en">
<head>
   <meta charset="UTF-8">
   <meta name="viewport" content="width=device-width, initial-scale=1.0">
   <link rel="shortcut icon" href="assets/img/favicon.png" type="image/x-icon">
   <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/remixicon/3.5.0/remixicon.css">
   <link rel="stylesheet" href="../../stylesheets/User/cart.css">
   <title>Cart - Book Mania</title>
</head>
<body>
   <!-- Include the navbar partial -->
   <%- include('partials/navbar') %>

   <main class="main">
      <!-- Checkout Progress -->
      <div class="checkout-progress">
         <div class="progress-step active" id="cart-step">
            <i class="ri-shopping-cart-line"></i>
            <span>Cart</span>
         </div>
         <div class="progress-line"></div>
         <div class="progress-step" id="address-step">
            <i class="ri-map-pin-line"></i>
            <span>Address</span>
         </div>
         <div class="progress-line"></div>
         <div class="progress-step" id="payment-step">
            <i class="ri-bank-card-line"></i>
            <span>Payment</span>
         </div>
      </div>

      <!-- Cart Section -->
      <section class="cart-section active" id="cart">
         <h2 class="section__title">Shopping Cart</h2>
         <div class="cart__container container">
            <div class="cart__items">
               <!-- Sample Cart Item -->
               <div class="cart__item">
                  <img src="../../img/book-1.png" alt="Book" class="cart__item-img">
                  <div class="cart__item-details">
                     <h3 class="cart__item-title">Book Title</h3>
                     <p class="cart__item-price">$19.99</p>
                     <div class="cart__item-quantity">
                        <button class="quantity-btn minus">-</button>
                        <input type="number" value="1" min="1" class="quantity-input">
                        <button class="quantity-btn plus">+</button>
                     </div>
                  </div>
                  <button class="cart__item-remove">
                     <i class="ri-delete-bin-line"></i>
                  </button>
               </div>
            </div>
            <div class="cart__summary">
               <h3>Order Summary</h3>
               <div class="summary__item">
                  <span>Subtotal</span>
                  <span>$19.99</span>
               </div>
               <div class="summary__item">
                  <span>Shipping</span>
                  <span>$5.00</span>
               </div>
               <div class="summary__item total">
                  <span>Total</span>
                  <span>$24.99</span>
               </div>
               <button class="button proceed-btn" onclick="showSection('address')">Proceed to Address</button>
            </div>
         </div>
      </section>

      <!-- Address Section -->
      <section class="address-section" id="address">
         <h2 class="section__title">Shipping Address</h2>
         <div class="address__container container">
            <div class="saved-addresses">
               <h3>Saved Addresses</h3>
               <div class="address-card selected">
                  <input type="radio" name="address" id="address1" checked>
                  <label for="address1">
                     <h4>Home</h4>
                     <p>John Doe</p>
                     <p>123 Main Street, Apt 4B</p>
                     <p>New York, NY 10001</p>
                     <p>Phone: (123) 456-7890</p>
                  </label>
               </div>
            </div>
            <div class="new-address">
               <h3>Add New Address</h3>
               <form class="address-form">
                  <div class="form-group">
                     <input type="text" placeholder="Full Name" required>
                  </div>
                  <div class="form-group">
                     <input type="text" placeholder="Mobile Number" required>
                  </div>
                  <div class="form-group">
                     <input type="text" placeholder="Street Address" required>
                  </div>
                  <div class="form-row">
                     <input type="text" placeholder="City" required>
                     <input type="text" placeholder="State" required>
                  </div>
                  <div class="form-group">
                     <input type="text" placeholder="ZIP Code" required>
                  </div>
               </form>
            </div>
            <div class="address-buttons">
               <button class="button back-btn" onclick="showSection('cart')">Back to Cart</button>
               <button class="button proceed-btn" onclick="showSection('payment')">Proceed to Payment</button>
            </div>
         </div>
      </section>

      <!-- Payment Section -->
      <section class="payment-section" id="payment">
         <h2 class="section__title">Payment Method</h2>
         <div class="payment__container container">
            <div class="payment-methods">
               <div class="payment-method">
                  <input type="radio" name="payment" id="card" checked>
                  <label for="card">
                     <i class="ri-bank-card-line"></i>
                     Credit/Debit Card
                  </label>
                  <div class="payment-form active">
                     <div class="form-group">
                        <input type="text" placeholder="Card Number" required>
                     </div>
                     <div class="form-row">
                        <input type="text" placeholder="MM/YY" required>
                        <input type="text" placeholder="CVV" required>
                     </div>
                     <div class="form-group">
                        <input type="text" placeholder="Name on Card" required>
                     </div>
                  </div>
               </div>
               <div class="payment-method">
                  <input type="radio" name="payment" id="upi">
                  <label for="upi">
                     <i class="ri-smartphone-line"></i>
                     UPI
                  </label>
                  <div class="payment-form">
                     <div class="form-group">
                        <input type="text" placeholder="UPI ID" required>
                     </div>
                  </div>
               </div>
               <div class="payment-method">
                  <input type="radio" name="payment" id="cod">
                  <label for="cod">
                     <i class="ri-money-dollar-box-line"></i>
                     Cash on Delivery
                  </label>
               </div>
            </div>
            <div class="payment__summary">
               <h3>Payment Summary</h3>
               <div class="summary__item">
                  <span>Order Total</span>
                  <span>$24.99</span>
               </div>
               <div class="summary__item">
                  <span>Payment Method</span>
                  <span>Credit Card</span>
               </div>
               <div class="summary__item total">
                  <span>Total to Pay</span>
                  <span>$24.99</span>
               </div>
            </div>
            <div class="payment-buttons">
               <button class="button back-btn" onclick="showSection('address')">Back to Address</button>
               <button class="button proceed-btn">Place Order</button>
            </div>
         </div>
      </section>
   </main>

   <!-- Footer -->
   <%- include('partials/footer') %>

   <script src="../../javascripts/cart.js"></script>
</body>
</html>